{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard deployments">
	<div class="ui container">
		<h2 class="ui header">{{.Title}}</h2>
		<p class="tw-text-14">
			Every run across the repositories you can see. Gitea shows runs one repository at a time;
			this is the aggregate, served by <code>{{.APIBase}}/insights</code>. Every figure here
			is also reachable on its own from <code>/runs</code>, <code>/workflows</code> and
			<code>/insights/repos</code>, and every detail links out to Gitea's own page.
		</p>

		<div class="ui form">
			<div class="inline field">
				<label for="deployments-window">Window</label>
				<select id="deployments-window" class="ui dropdown">
					<option value="1">last day</option>
					<option value="{{.DefaultWindowDays}}" selected>last {{.DefaultWindowDays}} days</option>
					<option value="30">last 30 days</option>
					<option value="90">last 90 days</option>
				</select>
				<button id="deployments-refresh" type="button" class="ui basic button">Refresh now</button>
				<span id="deployments-updated" class="tw-text-12"></span>
			</div>
		</div>

		<div id="deployments-error" class="ui negative message tw-hidden">
			<div class="header">Could not load insights</div>
			<p id="deployments-error-message"></p>
			<p><strong>Suggested action:</strong> <span id="deployments-error-action"></span></p>
		</div>

		<div id="deployments-truncated" class="ui warning message tw-hidden">
			<div class="header">These numbers are a floor, not a total</div>
			<p>The window holds more runs than one aggregate reads.</p>
			<p><strong>Suggested action:</strong> narrow the window, or filter to one repository.</p>
		</div>

		<h3 class="ui header">Summary <span class="tw-text-12">(previous window of equal length beside each)</span></h3>
		<table class="ui table" id="deployments-tiles">
			<thead><tr><th>Tile</th><th>This window</th><th>Previous window</th></tr></thead>
			<tbody id="deployments-tiles-body"><tr><td colspan="3">Loading…</td></tr></tbody>
		</table>

		<div class="ui two column stackable grid">
			<div class="column">
				<h3 class="ui header">Recent runs</h3>
				<table class="ui table"><tbody id="deployments-recent"><tr><td>Loading…</td></tr></tbody></table>
			</div>
			<div class="column">
				<h3 class="ui header">Failed runs</h3>
				<table class="ui table"><tbody id="deployments-failed"><tr><td>Loading…</td></tr></tbody></table>
			</div>
		</div>

		<h3 class="ui header">Top repositories by run volume</h3>
		<table class="ui table">
			<thead><tr><th>Repository</th><th>Runs</th><th>Success rate</th><th>Average duration</th></tr></thead>
			<tbody id="deployments-repos"><tr><td colspan="4">Loading…</td></tr></tbody>
		</table>

		<h3 class="ui header">Daily trend</h3>
		<table class="ui table">
			<thead><tr><th>Day</th><th>Runs</th><th>Successful</th><th>Failed</th><th>Average duration</th><th>Deployments</th></tr></thead>
			<tbody id="deployments-trend"><tr><td colspan="6">Loading…</td></tr></tbody>
		</table>
	</div>
</div>
<script type="module" nonce="{{ctx.CspScriptNonce}}">
const base = {{.APIBase}};
const subURL = {{.AppSubURL}};

// Gitea's own live-update transport is a per-user WebSocket carrying notification counts,
// stopwatches and logout, and nothing else. Publishing cross-repository run events onto it
// would need an entry in its client-side event allowlist — an upstream edit outside the
// fork's declared spoke set — so this page re-reads the same documented endpoints on an
// interval instead of opening a second transport of its own.
const refreshMillis = 30000;

const $ = (id) => document.querySelector(`#${id}`);

function fail(message, action) {
	$('deployments-error-message').textContent = message;
	$('deployments-error-action').textContent = action;
	$('deployments-error').classList.remove('tw-hidden');
}

function link(text, href, title) {
	const a = document.createElement('a');
	a.textContent = text;
	a.href = href;
	if (title) a.title = title;
	return a;
}

function row(cells) {
	const tr = document.createElement('tr');
	for (const cell of cells) {
		const td = document.createElement('td');
		if (cell instanceof Node) td.append(cell); else td.textContent = String(cell);
		tr.append(td);
	}
	return tr;
}

function percent(rate) {
	return `${Math.round((rate ?? 0) * 1000) / 10}%`;
}

function duration(seconds) {
	const s = Math.max(0, Math.round(seconds ?? 0));
	if (s < 60) return `${s}s`;
	if (s < 3600) return `${Math.floor(s / 60)}m ${s % 60}s`;
	return `${Math.floor(s / 3600)}h ${Math.floor((s % 3600) / 60)}m`;
}

async function get(path) {
	const resp = await fetch(base + path, {headers: {accept: 'application/json'}});
	const payload = await resp.json();
	if (!resp.ok) {
		const err = new Error(payload.message ?? `the API returned ${resp.status}`);
		err.action = payload.suggested_action ?? 'Retry, and check the server log if it keeps failing.';
		throw err;
	}
	return payload;
}

function renderTiles(overview) {
	const s = overview.summary;
	const p = overview.previous;
	const runsOf = (summary, state) => (summary.runs ?? {})[state] ?? 0;
	const rows = [
		['Repositories active', s.active_repositories, p.active_repositories],
		['Repositories inactive', s.inactive_repositories, p.inactive_repositories],
		['Workflows active', s.active_workflows, p.active_workflows],
		['Workflows disabled', s.disabled_workflows, p.disabled_workflows],
		['Runs total', s.total_runs, p.total_runs],
		['Runs succeeded', runsOf(s, 'success'), runsOf(p, 'success')],
		['Runs failed', runsOf(s, 'failure'), runsOf(p, 'failure')],
		['Runs in progress', runsOf(s, 'in_progress'), runsOf(p, 'in_progress')],
		['Runs queued', runsOf(s, 'queued'), runsOf(p, 'queued')],
		['Runs cancelled', runsOf(s, 'cancelled'), runsOf(p, 'cancelled')],
		['Success rate', percent(s.success_rate), percent(p.success_rate)],
		['Total duration', duration(s.total_duration_seconds), duration(p.total_duration_seconds)],
	];
	$('deployments-tiles-body').replaceChildren(...rows.map(row));
	$('deployments-truncated').classList.toggle('tw-hidden', !overview.truncated);
}

// Each run row links to the run in Gitea rather than rendering it here.
function renderRuns(target, runs, emptyText) {
	if (!runs.length) {
		$(target).replaceChildren(row([emptyText]));
		return;
	}
	$(target).replaceChildren(...runs.map((run) => {
		const label = document.createElement('span');
		label.append(link(`${run.repo_full_name} #${run.index}`,
			run.run_url || `${subURL}/${run.repo_full_name}/actions`, run.title));
		label.append(` · ${run.workflow_id} · ${run.status} · ${duration(run.duration_seconds)}`);
		return row([label]);
	}));
}

function renderRepos(repos) {
	if (!repos.length) {
		$('deployments-repos').replaceChildren(row(['no repository ran a workflow in this window', '', '', '']));
		return;
	}
	$('deployments-repos').replaceChildren(...repos.map((r) => row([
		link(r.repo_full_name, `${subURL}/${r.repo_full_name}/actions`, 'Open this repository’s runs in Gitea'),
		r.runs,
		percent(r.success_rate),
		duration(r.average_duration_seconds),
	])));
}

function renderTrend(points) {
	$('deployments-trend').replaceChildren(...points.map((p) => row([
		p.date, p.runs, p.successes, p.failures, duration(p.average_duration_seconds), p.deployments,
	])));
}

async function load() {
	const days = $('deployments-window').value;
	const windowParam = `window_days=${encodeURIComponent(days)}`;
	try {
		// Five documented endpoints, no private data path: the composite saves the page a
		// round trip, and each list is independently queryable.
		const [overview, recent, failed, repos, trends] = await Promise.all([
			get(`/insights?${windowParam}`),
			get(`/runs?limit=10&sort_by=created_unix&order=desc`),
			get(`/runs?limit=10&sort_by=created_unix&order=desc&status[eq]=failure`),
			get(`/insights/repos?${windowParam}&limit=10&sort_by=runs&order=desc`),
			get(`/insights/trends?${windowParam}`),
		]);
		$('deployments-error').classList.add('tw-hidden');
		renderTiles(overview);
		renderRuns('deployments-recent', recent, 'no run in this window');
		renderRuns('deployments-failed', failed, 'no failed run — nothing to chase');
		renderRepos(repos);
		renderTrend(trends);
		$('deployments-updated').textContent = `updated ${new Date().toLocaleTimeString()}`;
	} catch (err) {
		fail(String(err.message ?? err),
			err.action ?? `Check that you are signed in and that the deployments API is reachable at ${base}.`);
	}
}

$('deployments-window').addEventListener('change', load);
$('deployments-refresh').addEventListener('click', load);
setInterval(load, refreshMillis);
await load();
</script>
{{template "base/footer" .}}
