{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard deployments">
	<div class="ui container">
		<h2 class="ui header">{{.Title}}</h2>
		<p class="tw-text-14">
			Deploying is two steps. This is the second: nothing has been dispatched yet.
			Both steps are the same request to <code>POST {{.APIBase}}/deployments</code> —
			the first with <code>confirm: false</code>, which plans and dispatches nothing. Rolling
			back is this page with an earlier release tag; there is no separate rollback path.
		</p>

		<div id="deployments-error" class="ui negative message tw-hidden">
			<div class="header" id="deployments-error-header">Could not plan this deploy</div>
			<p id="deployments-error-message"></p>
			<p><strong>Suggested action:</strong> <span id="deployments-error-action"></span></p>
		</div>

		<div id="deployments-token-box" class="ui warning message tw-hidden">
			<div class="header">This page needs an API token</div>
			<p>
				Planning and dispatching a deploy authenticate with a token, never with your browser
				session, so that no other site holding your cookie can release one. Create a token
				under Settings &gt; Applications and paste it here; it is kept in this tab only.
			</p>
			<div class="ui action input">
				<input id="deployments-token" type="password" autocomplete="off" placeholder="API token">
				<button id="deployments-token-save" class="ui primary button" type="button">Use token</button>
			</div>
		</div>

		<div id="deployments-warning" class="ui warning message tw-hidden">
			<div class="header">Out of sequence</div>
			<p id="deployments-warning-message"></p>
			<p><strong>Suggested action:</strong> <span id="deployments-warning-action"></span></p>
		</div>

		<table class="ui definition table" id="deployments-plan">
			<tbody>
				<tr><td>Repository</td><td id="plan-repo">…</td></tr>
				<tr><td>Target environment</td><td id="plan-environment">…</td></tr>
				<tr><td>Release to deploy</td><td id="plan-release">…</td></tr>
				<tr><td>Currently live there</td><td id="plan-live">…</td></tr>
				<tr><td>Depends on</td><td id="plan-depends-on">…</td></tr>
				<tr><td>Workflow</td><td id="plan-workflow">…</td></tr>
			</tbody>
		</table>

		<div id="deployments-override" class="tw-hidden">
			<p class="tw-text-14">
				<label for="override-reason"><strong>Reason for overriding the sequence rule</strong></label><br>
				It is written to the append-only audit log against your account.
			</p>
			<textarea id="override-reason" rows="2" class="tw-w-full"></textarea>
		</div>

		<div class="tw-mt-3">
			<button id="deployments-confirm" class="ui primary button" disabled>Deploy</button>
			<a class="ui basic button" href="{{.AppSubURL}}/deployments">Cancel</a>
		</div>

		<div id="deployments-done" class="ui positive message tw-hidden">
			<div class="header">Dispatched</div>
			<p id="deployments-done-message"></p>
		</div>
	</div>
</div>
<script type="module" nonce="{{ctx.CspScriptNonce}}">
const base = {{.APIBase}};
const subURL = {{.AppSubURL}};
const pageToken = {{.PageToken}};
const params = new URLSearchParams(window.location.search);
const request = {
	repo: params.get('repo') ?? '',
	environment: params.get('environment') ?? '',
	release_tag: params.get('release_tag') ?? '',
};
const tokenKey = 'deployments-api-token';
function storedToken() {
	try {
		return window.sessionStorage.getItem(tokenKey) ?? pageToken ?? '';
	} catch {
		return pageToken ?? '';
	}
}

const confirmButton = document.querySelector('#deployments-confirm');
const overrideBox = document.querySelector('#deployments-override');
const reasonField = document.querySelector('#override-reason');

function text(id, value) {
	document.querySelector(id).textContent = value;
}

// Every error carries a suggested next action, and the page prints it.
function fail(header, message, action) {
	text('#deployments-error-header', header);
	text('#deployments-error-message', message);
	text('#deployments-error-action', action);
	document.querySelector('#deployments-error').classList.remove('tw-hidden');
}

// post is the single request both steps compose. Only `confirm` differs, so nothing the
// confirm step showed can drift from what the dispatch actually asks for.
async function post(confirm, overrideReason) {
	const body = {...request, confirm};
	if (overrideReason) body.override_reason = overrideReason;
	const headers = {'content-type': 'application/json', accept: 'application/json'};
	const token = storedToken();
	if (token) headers.authorization = `token ${token}`;
	const resp = await fetch(`${base}/deployments`, {
		method: 'POST',
		headers,
		body: JSON.stringify(body),
	});
	if (resp.status === 401 || resp.status === 403) {
		document.querySelector('#deployments-token-box').classList.remove('tw-hidden');
	}
	return {status: resp.status, payload: await resp.json()};
}

function renderPlan(plan) {
	text('#plan-repo', plan.repo_full_name);
	text('#plan-environment', plan.environment);
	text('#plan-release', plan.release_tag + (plan.is_prerelease ? ' (prerelease)' : '') +
		(plan.is_rollback ? ' — this is a rollback' : ''));
	text('#plan-live', plan.currently_live || 'nothing has ever succeeded here');
	text('#plan-depends-on', plan.depends_on && plan.depends_on.length
		? `${plan.depends_on.join(', ')} — ${plan.predecessor_state}`
		: 'none declared');
	text('#plan-workflow', `${plan.workflow_id} at ${plan.ref}`);

	if (plan.outcome === 'refuse') {
		fail('This deploy is refused', plan.message, plan.suggested_action);
		return;
	}
	if (plan.outcome === 'warn' || plan.outcome === 'override') {
		text('#deployments-warning-message', plan.message);
		text('#deployments-warning-action', plan.suggested_action);
		document.querySelector('#deployments-warning').classList.remove('tw-hidden');
	}
	if (plan.requires_override_reason) {
		overrideBox.classList.remove('tw-hidden');
		confirmButton.textContent = 'Override and deploy';
	}
	confirmButton.disabled = false;
}

confirmButton.addEventListener('click', async () => {
	confirmButton.disabled = true;
	try {
		const {status, payload} = await post(true, reasonField.value.trim());
		if (status >= 400 || !payload.confirmed) {
			fail('Not dispatched', payload.message ?? `the API returned ${status}`,
				payload.suggested_action ?? 'Retry, and check the server log if it keeps failing.');
			confirmButton.disabled = false;
			return;
		}
		const done = document.querySelector('#deployments-done');
		text('#deployments-done-message',
			`${payload.release_tag} is deploying to ${payload.environment}. Run ${payload.run_id}.`);
		done.classList.remove('tw-hidden');
		const link = document.createElement('a');
		link.href = payload.run_url || `${subURL}/${payload.repo_full_name}/actions`;
		link.textContent = 'Open the run';
		document.querySelector('#deployments-done-message').after(' ', link);
	} catch (err) {
		fail('Not dispatched', String(err),
			'Check that you are signed in and that the deployments API is reachable at ' + base + '.');
		confirmButton.disabled = false;
	}
});

try {
	if (!request.repo || !request.environment || !request.release_tag) {
		fail('Nothing to confirm', 'the link carries no repo, environment and release_tag',
			'Open this page from a matrix cell, which fills all three in.');
	} else {
		const {status, payload} = await post(false, '');
		// A 403 is normally the sequence rule refusing, which renders as a plan. An auth 403
		// carries no plan at all, so it must not reach renderPlan.
		if (status >= 400 && (status !== 403 || payload.code === 'sign_in_required')) {
			fail('Could not plan this deploy', payload.message ?? `the API returned ${status}`,
				payload.suggested_action ?? 'Retry, and check the server log if it keeps failing.');
		} else {
			renderPlan(payload);
		}
	}
} catch (err) {
	fail('Could not plan this deploy', String(err),
		'Check that you are signed in and that the deployments API is reachable at ' + base + '.');
}

document.querySelector('#deployments-token-save').addEventListener('click', () => {
	try {
		window.sessionStorage.setItem(tokenKey, document.querySelector('#deployments-token').value.trim());
	} catch {
		fail('Could not keep the token', 'this browser refused to keep the token for this tab',
			'Allow site data for this origin, or use the gitea-deployments CLI instead.');
		return;
	}
	window.location.reload();
});
</script>
{{template "base/footer" .}}
