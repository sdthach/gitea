{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard planning">
	<div class="ui container">
		<h2 class="ui header">{{.Title}}</h2>
		<p class="tw-text-14">
			Gitea's project columns run across; the groups run down. Gitea models no group at all —
			<code>project.Column</code> carries a title, a sort order, a colour and a project and nothing
			else — so a group is a rendering over rows the API already returns. Grouping is a view
			setting, never stored on the board, so two people may group the same board differently.
			Every figure is fetched from <code>{{.APIBase}}/board</code>; this page is a client
			of that endpoint and reads nothing the API does not serve.
		</p>

		<div class="ui form">
			<div class="inline fields">
				<div class="field">
					<label for="planning-repo">Repository id</label>
					<input id="planning-repo" type="number" min="1" size="6">
				</div>
				<div class="field">
					<label for="planning-project">Board id</label>
					<input id="planning-project" type="number" min="1" size="6">
				</div>
				<div class="field">
					<label for="planning-group">Groups by</label>
					<select id="planning-group" class="ui dropdown">
						{{range .Groupings}}<option value="{{.}}">{{.}}</option>{{end}}
					</select>
				</div>
				<div class="field">
					<button id="planning-load" class="ui primary button" type="button">Show board</button>
				</div>
			</div>
		</div>

		<div id="planning-error" class="ui negative message tw-hidden">
			<div class="header">Could not load the board</div>
			<p id="planning-error-message"></p>
			<p><strong>Suggested action:</strong> <span id="planning-error-action"></span></p>
		</div>

		<div id="planning-token-box" class="ui warning message tw-hidden">
			<div class="header">This page needs an API token</div>
			<p>
				The planning API authenticates with a token, not with your browser session, so no card
				can be moved by another site holding your cookie. Create one under Settings &gt;
				Applications and paste it here; it is kept in this tab only.
			</p>
			<div class="ui action input">
				<input id="planning-token" type="password" autocomplete="off" placeholder="API token">
				<button id="planning-token-save" class="ui primary button" type="button">Use token</button>
			</div>
		</div>

		<h3 id="planning-board-title" class="ui header tw-hidden"></h3>
		<div class="tw-overflow-x-auto">
			<table class="ui celled table" id="planning-board">
				<thead><tr id="planning-board-head"></tr></thead>
				<tbody id="planning-board-body">
					<tr><td>Name a repository and a board, then press Show board.</td></tr>
				</tbody>
			</table>
		</div>

		<p class="tw-text-12">
			Two writes exist on this board and no others: moving a card between columns, and moving it
			between groups, which edits the grouping field itself — the <code>type:</code> label, an
			issue's parent or the assignee. A group move is refused when grouping is off,
			because there is then nothing to write.
		</p>
	</div>
</div>
<script type="module" nonce="{{ctx.CspScriptNonce}}">
const base = {{.APIBase}};
const subURL = {{.AppSubURL}};
const pageToken = {{.PageToken}};

// The documented operation paths for the two writes, spelled exactly as the published
// document spells them, so this page names the endpoints it is a client of rather than a
// rewritten copy of them.
const columnMovePath = '/board/cards/{issue_id}/column';
const groupMovePath = '/board/cards/{issue_id}/group';

const head = document.querySelector('#planning-board-head');
const body = document.querySelector('#planning-board-body');
const heading = document.querySelector('#planning-board-title');
const tokenBox = document.querySelector('#planning-token-box');
const tokenInput = document.querySelector('#planning-token');
const repoInput = document.querySelector('#planning-repo');
const projectInput = document.querySelector('#planning-project');
const groupSelect = document.querySelector('#planning-group');

const tokenKey = 'planning-api-token';
function storedToken() {
	try {
		return window.sessionStorage.getItem(tokenKey) ?? pageToken ?? '';
	} catch {
		return pageToken ?? '';
	}
}

function headers(withBody) {
	const out = {accept: 'application/json'};
	if (withBody) out['content-type'] = 'application/json';
	const token = storedToken();
	if (token) out.authorization = `token ${token}`;
	return out;
}

function fail(message, action) {
	document.querySelector('#planning-error-message').textContent = message;
	document.querySelector('#planning-error-action').textContent = action;
	document.querySelector('#planning-error').classList.remove('tw-hidden');
}

function clearError() {
	document.querySelector('#planning-error').classList.add('tw-hidden');
}

let current = null;

// render lays the board out as groups down and columns across. Every group carries every
// column, so the table is a rectangle whatever the grouping.
function render(board) {
	current = board;
	heading.textContent = `${board.title} — ${board.repo_full_name}`;
	heading.classList.remove('tw-hidden');

	const groupHeader = document.createElement('th');
	groupHeader.textContent = board.group_by === 'none' ? '' : board.group_by;
	head.replaceChildren(groupHeader);
	for (const column of board.columns) {
		const th = document.createElement('th');
		th.textContent = column.title;
		head.append(th);
	}

	body.replaceChildren(...board.groups.map((group) => {
		const tr = document.createElement('tr');
		const groupCell = document.createElement('th');
		groupCell.textContent = group.label;
		if (group.is_empty_value) {
			// The empty-value group is explicit. It reads as a fact about the issues,
			// not as a blank row.
			groupCell.append(Object.assign(document.createElement('div'), {
				className: 'tw-text-12',
				textContent: 'no value for this grouping',
			}));
		}
		tr.append(groupCell);

		for (const column of group.columns) {
			const td = document.createElement('td');
			td.append(...column.cards.map((card) => cardElement(board, group, card)));
			if (!column.cards.length) td.textContent = '—';
			tr.append(td);
		}
		return tr;
	}));
}

function cardElement(board, group, card) {
	const wrapper = document.createElement('div');
	wrapper.className = 'tw-mb-2';

	const link = document.createElement('a');
	link.href = `${subURL}${card.url}`;
	link.textContent = `#${card.number} ${card.title}`;
	wrapper.append(link);

	if (board.can_write && board.columns.length > 1) {
		wrapper.append(move('column', board.columns.map((c) => [String(c.column_id), c.title]),
			String(card.column_id), (value) => moveColumn(card, Number(value))));
	}
	if (board.can_edit_issue && board.group_by !== 'none') {
		const groups = board.groups.map((g) => [g.key, g.label]);
		wrapper.append(move('group', groups, group.key, (value) => moveGroup(card, value)));
	}
	return wrapper;
}

function move(name, options, selected, onChange) {
	const select = document.createElement('select');
	select.className = 'ui dropdown tw-ml-2';
	select.title = `move this card to another ${name}`;
	for (const [value, label] of options) {
		const option = document.createElement('option');
		option.value = value;
		option.textContent = label;
		if (value === selected) option.selected = true;
		select.append(option);
	}
	select.addEventListener('change', () => onChange(select.value));
	return select;
}

async function post(path, payload) {
	clearError();
	const resp = await fetch(`${base}${path}`, {
		method: 'POST', headers: headers(true), body: JSON.stringify(payload),
	});
	const data = await resp.json().catch(() => ({}));
	if (!resp.ok) {
		if (resp.status === 401 || resp.status === 403) tokenBox.classList.remove('tw-hidden');
		fail(data.message ?? `the API returned ${resp.status}`,
			data.suggested_action ?? 'Retry, and check the server log if it keeps failing.');
		return;
	}
	render(data);
}

function moveColumn(card, columnID) {
	return post(columnMovePath.replace('{issue_id}', String(card.issue_id)), {
		repo: current.repo_full_name, project_id: current.project_id,
		column_id: columnID, group_by: current.group_by,
	});
}

function moveGroup(card, group) {
	return post(groupMovePath.replace('{issue_id}', String(card.issue_id)), {
		repo: current.repo_full_name, project_id: current.project_id,
		group_by: current.group_by, group,
	});
}

async function load() {
	const repoID = repoInput.value.trim();
	const projectID = projectInput.value.trim();
	if (!repoID || !projectID) {
		fail('a board belongs to one repository, so both ids are needed',
			'Enter the repository id and the board id. An epic sync records the board id as .board.number in the epic sync-manifest.json.');
		return;
	}
	const params = new URLSearchParams({repo_id: repoID, project_id: projectID, group_by: groupSelect.value});

	let payload;
	try {
		const resp = await fetch(`${base}/board?${params}`, {headers: headers(false)});
		payload = await resp.json();
		if (!resp.ok) {
			if (resp.status === 401 || resp.status === 403) tokenBox.classList.remove('tw-hidden');
			// A build without the Projects API, or a repository with the unit switched
			// off, answers here with the reason and what to do about it — the board
			// degrades rather than breaking, and the roadmap still renders.
			fail(payload.message ?? `the API returned ${resp.status}`,
				payload.suggested_action ?? 'Retry, and check the server log if it keeps failing.');
			body.replaceChildren();
			head.replaceChildren();
			heading.classList.add('tw-hidden');
			return;
		}
	} catch (err) {
		fail(String(err), `Check that you are signed in and that the planning API is reachable at ${base}.`);
		return;
	}

	clearError();
	tokenBox.classList.add('tw-hidden');
	render(payload);
}

document.querySelector('#planning-token-save').addEventListener('click', () => {
	try {
		window.sessionStorage.setItem(tokenKey, tokenInput.value.trim());
	} catch {
		fail('this browser refused to keep the token for this tab',
			'Allow site data for this origin, or use the gitea-planning CLI instead.');
		return;
	}
	load();
});
document.querySelector('#planning-load').addEventListener('click', load);
groupSelect.addEventListener('change', () => {
	if (current) load();
});
</script>
{{template "base/footer" .}}
