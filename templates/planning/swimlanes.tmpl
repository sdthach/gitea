{{if and .EnableSwimlanes .Repository .Project}}
<div class="ui container flex-text-block tw-mb-2" id="planning-swimlanes"
	data-repo-id="{{.Repository.ID}}" data-project-id="{{.Project.ID}}"
	data-api-base="{{AppSubUrl}}/api/planning/v1" data-repo-full-name="{{.Repository.FullName}}">
	<label class="tw-mr-2" for="planning-swimlane-grouping">Swimlanes</label>
	<select id="planning-swimlane-grouping" class="ui dropdown">
		<option value="none">no grouping</option>
		<option value="type">by type</option>
		<option value="epic">by epic</option>
		<option value="assignee">by assignee</option>
	</select>
	<span class="tw-ml-2 tw-text-12" id="planning-swimlane-note"></span>
</div>
<script type="module" nonce="{{ctx.CspScriptNonce}}">
// The project board is Gitea's. This groups the cards it already rendered into swimlanes and
// puts them back when grouping is off, so the page a build without ENABLE_SWIMLANES renders
// is untouched. Group membership and the group move both come from the planning API, which is
// the same source and the same write the fork's own board page uses.
const root = document.querySelector('#planning-swimlanes');
const board = document.querySelector('#project-board');
const note = document.querySelector('#planning-swimlane-note');
const select = document.querySelector('#planning-swimlane-grouping');
if (root && board) {
	const base = root.dataset.apiBase;
	const repoID = root.dataset.repoId;
	const projectID = root.dataset.projectId;
	const repoFullName = root.dataset.repoFullName;
	// The board Gitea drew, kept so "no grouping" restores it rather than redrawing it.
	const ungrouped = board.cloneNode(true);
	const groupingKey = `planning-swimlane-grouping-${projectID}`;

	function say(text) {
		note.textContent = text;
	}

	function restore() {
		board.replaceChildren(...[...ungrouped.cloneNode(true).children]);
		say('');
	}

	// groupRow builds one swimlane: its heading, then a copy of every column holding only
	// the cards this group owns. A card is moved, never cloned, so nothing appears twice.
	function groupRow(group, cards) {
		const row = document.createElement('div');
		row.className = 'planning-swimlane tw-mb-4';

		const heading = document.createElement('h4');
		heading.className = 'ui header tw-mb-1';
		heading.textContent = `${group.label} (${group.cards})`;
		row.append(heading);

		const columns = document.createElement('div');
		columns.className = 'board';
		for (const column of group.columns) {
			const source = ungrouped.querySelector(`.project-column[data-id="${column.column_id}"]`);
			if (!source) continue;
			const shell = source.cloneNode(false);
			const header = source.querySelector('.project-column-header');
			if (header) shell.append(header.cloneNode(true));
			const holder = document.createElement('div');
			holder.className = 'ui cards';
			for (const card of column.cards) {
				const node = cards.get(card.issue_id);
				if (node) holder.append(node);
			}
			shell.append(holder);
			columns.append(shell);
		}
		row.append(columns);
		return row;
	}

	async function group(grouping) {
		try {
			window.localStorage.setItem(groupingKey, grouping);
		} catch {
			// A browser that refuses site data still groups; it just does not remember.
		}
		if (grouping === 'none') {
			restore();
			return;
		}

		let payload;
		try {
			const resp = await fetch(
				`${base}/board?repo_id=${repoID}&project_id=${projectID}&group_by=${grouping}`,
				{headers: {accept: 'application/json'}},
			);
			payload = await resp.json();
			if (!resp.ok) {
				say(payload.suggested_action ?? `the planning API returned ${resp.status}`);
				restore();
				return;
			}
		} catch (err) {
			say(`the planning API is not reachable: ${err}`);
			restore();
			return;
		}

		// Cards are taken out of the board Gitea drew and placed into swimlanes. One that the
		// API does not mention stays out, and the count says so rather than hiding it.
		const cards = new Map();
		for (const node of board.querySelectorAll('.issue-card[data-issue]')) {
			cards.set(Number(node.dataset.issue), node);
		}
		const rows = payload.groups.map((group) => groupRow(group, cards));
		const placed = rows.reduce((n, row) => n + row.querySelectorAll('.issue-card').length, 0);
		board.replaceChildren(...rows);
		board.classList.remove('sortable');
		say(placed === cards.size
			? `${payload.groups.length} swimlanes. Dragging is off while grouped; move a card on the planning board.`
			: `${placed} of ${cards.size} cards placed; the rest are not on this grouping's swimlanes.`);
	}

	select.addEventListener('change', () => group(select.value));
	let remembered = 'none';
	try {
		remembered = window.localStorage.getItem(groupingKey) ?? 'none';
	} catch {
		remembered = 'none';
	}
	if (remembered !== 'none') {
		select.value = remembered;
		group(remembered);
	}
}
</script>
{{end}}
