{{if not .Issue.IsPull}}
<div class="divider"></div>
<span class="text"><strong>Planning</strong></span>
{{/* issue-sidebar.ts always renders; only its writes 403 when planning pages are disabled. */}}
<div class="issue-sidebar-planning" data-global-init="initPlanningIssueSidebar" data-issue-id="{{.Issue.ID}}" data-can-write="{{.HasIssuesOrPullsWritePermission}}" data-post-base="{{AppSubUrl}}/planning"></div>
{{end}}
