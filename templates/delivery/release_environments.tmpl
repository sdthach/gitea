{{if and .IsSigned .Repository}}
<script type="module" nonce="{{ctx.CspScriptNonce}}" data-delivery-release-environments data-repo-id="{{.Repository.ID}}"
	data-api-base="{{AppSubUrl}}/api/delivery/v1">
// SC13: a release says where it is running. The badges are drawn from the grid endpoint —
// the same projection /delivery/grid renders — so the release page introduces no second
// answer to "what is live where". Tags come from the release entries the page already drew,
// so this adds no markup to the release list itself.
const script = document.querySelector('script[data-delivery-release-environments]');
const base = script.dataset.apiBase;
const repoID = script.dataset.repoId;

// Each entry's tag link is the one anchor whose href names a tag under this repository.
const entries = new Map();
for (const entry of document.querySelectorAll('#release-list .release-entry')) {
	const link = entry.querySelector('.meta a[href*="/src/tag/"]');
	const tag = link?.textContent.trim();
	const title = entry.querySelector('.release-list-title');
	if (tag && title) entries.set(tag, title);
}

if (entries.size) {
	try {
		const resp = await fetch(`${base}/grid?repo_id=${repoID}&limit=200`, {headers: {accept: 'application/json'}});
		if (resp.ok) {
			for (const row of await resp.json()) {
				const title = entries.get(row.release_tag);
				if (!title) continue;
				// Only the cells that actually hold the release: an environment the release
				// has never reached is not news on the release page.
				const live = row.cells.filter((cell) => cell.state === 'live');
				if (!live.length) continue;
				const holder = document.createElement('span');
				holder.className = 'tw-flex tw-gap-1';
				for (const cell of live) {
					const badge = document.createElement('a');
					badge.className = 'ui label tw-text-12';
					badge.href = `${base.replace('/api/delivery/v1', '')}/delivery/grid`;
					badge.textContent = `${cell.symbol} ${cell.environment}`;
					badge.title = `${row.release_tag} is live in ${cell.environment}`;
					holder.append(badge);
				}
				title.append(holder);
			}
		}
	} catch {
		// The release page is Gitea's and stands on its own; a delivery API that is not
		// answering leaves it exactly as it was.
	}
}
</script>
{{end}}
