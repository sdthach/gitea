{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard delivery">
	<div class="ui container">
		<h2 class="ui header">{{.Title}}</h2>
		<p class="tw-text-14">
			One bar per issue, with dependency arrows. It needs no Projects API, so it renders on a
			build whose board does not. Gitea stores no start date, so a bar's start comes from ccpm's
			own <code>started:</code> record and falls back to the issue's creation time; its end is
			the close time, then the deadline, then the effort estimate applied to the start. Every bar
			names both sources, and an <strong>inferred</strong> end is drawn as an open outline rather
			than a solid bar — presenting an estimate as a measurement is this view's characteristic
			failure. Zoom reads the same plan at epic or milestone depth, where a row is a bracket over
			the work filed under it rather than a bar. Every figure is fetched from
			<code>{{.DeliveryAPIBase}}/timeline</code>; this page is a client of that endpoint and reads
			nothing the API does not serve, including the time axis and every rollup.
		</p>

		<div class="ui form">
			<div class="inline fields">
				<div class="field">
					<label for="delivery-repo">Repository id</label>
					<input id="delivery-repo" type="number" min="1" size="6">
				</div>
				<div class="field">
					<label for="delivery-zoom">Zoom</label>
					<select id="delivery-zoom">
						<option value="issue">issue</option>
						<option value="epic">epic</option>
						<option value="milestone">milestone</option>
					</select>
				</div>
				<div class="field">
					<label for="delivery-group">Group by</label>
					<select id="delivery-group">
						<option value="none">none</option>
						<option value="type">type</option>
						<option value="epic">epic</option>
						<option value="assignee">assignee</option>
					</select>
				</div>
				<div class="field">
					<label for="delivery-epic">Epic (optional)</label>
					<input id="delivery-epic" type="text" size="18">
				</div>
				<div class="field">
					<label for="delivery-milestone">Milestone</label>
					<select id="delivery-milestone">
						<option value="0">all</option>
					</select>
				</div>
				<div class="field">
					<label for="delivery-state">State</label>
					<select id="delivery-state" class="ui dropdown">
						<option value="all">all</option>
						<option value="open">open</option>
						<option value="closed">closed</option>
					</select>
				</div>
				<div class="field">
					<button id="delivery-load" class="ui primary button" type="button">Show timeline</button>
				</div>
			</div>
		</div>

		<div id="delivery-error" class="ui negative message tw-hidden">
			<div class="header">Could not load the timeline</div>
			<p id="delivery-error-message"></p>
			<p><strong>Suggested action:</strong> <span id="delivery-error-action"></span></p>
		</div>

		<div id="delivery-token-box" class="ui warning message tw-hidden">
			<div class="header">This page needs an API token</div>
			<p>
				The delivery API authenticates with a token, not with your browser session. Create one
				under Settings &gt; Applications and paste it here; it is kept in this tab only.
			</p>
			<div class="ui action input">
				<input id="delivery-token" type="password" autocomplete="off" placeholder="API token">
				<button id="delivery-token-save" class="ui primary button" type="button">Use token</button>
			</div>
		</div>

		<div id="delivery-edit" class="ui segment tw-hidden">
			<div class="ui form">
				<div class="inline fields">
					<div class="field">
						<label for="delivery-new-row">New row</label>
						<input id="delivery-new-row" type="text" size="16" placeholder="Milestone title">
					</div>
					<div class="field">
						<label for="delivery-new-row-end">Due</label>
						<input id="delivery-new-row-end" type="date">
					</div>
					<div class="field">
						<button id="delivery-add-row" class="ui button" type="button">Add row</button>
					</div>
					<div class="field">
						<label for="delivery-new-issue">New issue</label>
						<input id="delivery-new-issue" type="text" size="18" placeholder="Title">
					</div>
					<div class="field">
						<label for="delivery-new-issue-epic">Epic</label>
						<input id="delivery-new-issue-epic" type="text" size="10" placeholder="checkout">
					</div>
					<div class="field">
						<label for="delivery-new-issue-row">On row</label>
						<select id="delivery-new-issue-row" class="ui dropdown"></select>
					</div>
					<div class="field">
						<button id="delivery-add-issue" class="ui button" type="button">Add issue</button>
					</div>
				</div>
			</div>
			<p class="tw-text-12">
				Drag a bar sideways to move the schedule; drag either end to move that end alone. The
				Start and End cells show the day the release will write while you drag, because at a
				coarse ruler one pixel is several days. When the chart is grouped, drag a bar up or down
				onto a lane heading to move it between lanes, which edits the grouping field itself —
				the <code>type:</code> label, the <code>epic:</code> label or the assignee. A drag
				writes the day it lands on at every zoom — the end to the issue's deadline, the start
				to ccpm's <code>started:</code> marker, because Gitea has nowhere else to keep one.
			</p>
		</div>

		<div id="delivery-truncated" class="ui warning message tw-hidden">
			<p id="delivery-truncated-message"></p>
		</div>

		<div class="tw-overflow-x-auto">
			<table class="ui table" id="delivery-timeline">
				<thead>
					<tr>
						<th>Issue</th>
						<th>Row</th>
						<th>Start</th>
						<th>End</th>
						<th>Schedule</th>
						<th>Depends on</th>
						<th>Warning</th>
					</tr>
					<tr>
						<th colspan="4" class="tw-font-normal tw-text-12" id="delivery-ruler-unit"></th>
						<th id="delivery-ruler" class="tw-font-normal"></th>
						<th colspan="2"></th>
					</tr>
				</thead>
				<tbody id="delivery-timeline-body">
					<tr><td colspan="7">Name a repository, then press Show timeline.</td></tr>
				</tbody>
			</table>
		</div>

		<h3 class="ui header">Epics and milestones</h3>
		<table class="ui table">
			<thead><tr><th>Row</th><th>Span</th><th>Progress</th><th>Firmness</th></tr></thead>
			<tbody id="delivery-spans"><tr><td colspan="4">—</td></tr></tbody>
		</table>

		<h3 class="ui header">Not on the chart</h3>
		<p class="tw-text-12">
			An issue ccpm does not manage has no start to draw. It is listed here with the reason
			rather than given a fabricated bar.
		</p>
		<table class="ui table">
			<thead><tr><th>Issue</th><th>Reason</th><th>Suggested action</th></tr></thead>
			<tbody id="delivery-unmanaged"><tr><td colspan="3">—</td></tr></tbody>
		</table>
	</div>
</div>
<script type="module" nonce="{{ctx.CspScriptNonce}}">
const base = {{.DeliveryAPIBase}};
const subURL = {{.AppSubURL}};
const pageToken = {{.DeliveryPageToken}};

// The vertical drag's endpoint, spelled as the published document spells it, so this page
// names the operation it is a client of rather than a rewritten copy of it.
const laneMovePath = '/timeline/issues/{issue_id}/lane';

const body = document.querySelector('#delivery-timeline-body');
const spansBody = document.querySelector('#delivery-spans');
const unmanagedBody = document.querySelector('#delivery-unmanaged');
const tokenBox = document.querySelector('#delivery-token-box');
const tokenInput = document.querySelector('#delivery-token');
const repoInput = document.querySelector('#delivery-repo');
const epicInput = document.querySelector('#delivery-epic');
const stateSelect = document.querySelector('#delivery-state');
const zoomSelect = document.querySelector('#delivery-zoom');
const groupSelect = document.querySelector('#delivery-group');
const milestoneSelect = document.querySelector('#delivery-milestone');
const rulerCell = document.querySelector('#delivery-ruler');
const rulerUnitCell = document.querySelector('#delivery-ruler-unit');
const truncatedBox = document.querySelector('#delivery-truncated');

// What the last load said about the chart: whether this caller may edit it, the rows an
// issue can be filed under, the repository the writes name, and the view it was read at.
let canWrite = false;
let rows = [];
let repoFullName = '';
let groupBy = 'none';
let zoom = 'issue';

const columns = 7;
const daySeconds = 86400;
// Below this the pointer has not yet said which gesture it is, so nothing moves.
const axisThreshold = 6;

const tokenKey = 'delivery-api-token';
function storedToken() {
	try {
		return window.sessionStorage.getItem(tokenKey) ?? pageToken ?? '';
	} catch {
		return pageToken ?? '';
	}
}

function headers() {
	const out = {accept: 'application/json'};
	const token = storedToken();
	if (token) out.authorization = `token ${token}`;
	return out;
}

function fail(message, action) {
	document.querySelector('#delivery-error-message').textContent = message;
	document.querySelector('#delivery-error-action').textContent = action;
	document.querySelector('#delivery-error').classList.remove('tw-hidden');
}

function clearError() {
	document.querySelector('#delivery-error').classList.add('tw-hidden');
}

function cell(row, text) {
	const td = document.createElement('td');
	td.textContent = text;
	row.append(td);
	return td;
}

function day(unix) {
	if (!unix) return '—';
	return new Date(unix * 1000).toISOString().slice(0, 10);
}

// span is the axis the whole chart is drawn against: the server's ruler, extended to its
// first tick so a tick that sits on the boundary before the earliest bar still lands on the
// track. The unit is the server's and is never recomputed here.
function chartSpan(payload) {
	const ruler = payload.ruler;
	let start = ruler.start_unix;
	if (ruler.ticks.length && ruler.ticks[0].unix < start) start = ruler.ticks[0].unix;
	return {start, end: Math.max(ruler.end_unix, start + daySeconds)};
}

function percent(span, unix) {
	return ((unix - span.start) / Math.max(span.end - span.start, 1)) * 100;
}

function track() {
	const el = document.createElement('div');
	el.className = 'tw-w-full';
	el.style.position = 'relative';
	el.style.height = '14px';
	return el;
}

function drawRuler(payload, span) {
	const ruler = payload.ruler;
	rulerUnitCell.textContent = ruler.ticks.length ? `${ruler.unit} ruler` : '';
	const line = track();
	line.append(...ruler.ticks.map((tick) => {
		const label = document.createElement('span');
		label.className = 'tw-text-12';
		label.style.position = 'absolute';
		label.style.left = `${percent(span, tick.unix)}%`;
		label.style.whiteSpace = 'nowrap';
		label.textContent = tick.label;
		return label;
	}));
	rulerCell.replaceChildren(line);
}

// bar draws one issue's schedule. An inferred end is an open outline, a recorded one is
// solid, so an estimated bar can never be read as a measured one. When the caller may write,
// the bar is a drag handle: its body moves the whole schedule and either edge moves that end.
function bar(container, span, item, readout, lane) {
	const drawn = document.createElement('div');
	drawn.style.position = 'absolute';
	drawn.style.left = `${percent(span, item.start_unix)}%`;
	drawn.style.width = `${Math.max(percent(span, item.end_unix) - percent(span, item.start_unix), 1)}%`;
	drawn.style.height = '12px';
	drawn.style.borderRadius = '3px';
	if (item.end_inferred) {
		drawn.style.border = '2px dashed currentColor';
		drawn.title = `inferred end (${item.end_source})`;
	} else {
		drawn.style.background = 'currentColor';
		drawn.title = `recorded end (${item.end_source})`;
	}
	if (canWrite) makeDraggable(drawn, container, span, item, readout, lane);
	container.append(drawn);
	return drawn;
}

// bracket draws a rolled-up row: three sides, so its ends read as caps over a set rather
// than as a bar with a body. It is never draggable — its window is derived from its
// children, so dragging it would be editing a projection.
function bracket(container, span, row) {
	const drawn = document.createElement('div');
	drawn.className = 'delivery-bracket';
	drawn.style.position = 'absolute';
	drawn.style.left = `${percent(span, row.start_unix)}%`;
	drawn.style.width = `${Math.max(percent(span, row.end_unix) - percent(span, row.start_unix), 1)}%`;
	drawn.style.top = '2px';
	drawn.style.height = '10px';
	drawn.style.borderLeft = '2px solid currentColor';
	drawn.style.borderRight = '2px solid currentColor';
	drawn.style.borderBottom = '2px solid currentColor';
	drawn.title = `${row.kind} ${row.label}: ${day(row.start_unix)} → ${day(row.end_unix)}`;
	container.append(drawn);
	return drawn;
}

// descend opens a bracket: it narrows to what the bracket covers and drops to the level the
// children live at.
function descend(row) {
	if (row.kind === 'epic') {
		epicInput.value = row.key;
		milestoneSelect.value = '0';
	} else {
		milestoneSelect.value = row.key;
		epicInput.value = '';
	}
	zoomSelect.value = 'issue';
	load();
}

// makeDraggable: the left sixth moves the start, the right sixth the end, the middle both; a
// drag past the threshold is sideways (dates) or vertical (lane), and always writes a whole day.
function makeDraggable(drawn, container, span, item, readout, lane) {
	drawn.style.cursor = 'grab';
	drawn.style.touchAction = 'none';
	drawn.addEventListener('pointerdown', (down) => {
		down.preventDefault();
		const rect = drawn.getBoundingClientRect();
		const grip = rect.width < 12 ? 'move'
			: down.clientX - rect.left < rect.width / 6 ? 'start'
				: rect.right - down.clientX < rect.width / 6 ? 'end' : 'move';
		const perPixel = Math.max(span.end - span.start, 1) / Math.max(container.getBoundingClientRect().width, 1);
		let start = item.start_unix;
		let end = item.end_unix;
		let axis = '';
		let target = null;

		const dropTarget = (at) => {
			const under = document.elementFromPoint(at.clientX, at.clientY);
			const found = under ? under.closest('tr[data-lane]') : null;
			if (found === target) return;
			if (target) target.classList.remove('active');
			target = found;
			if (target) target.classList.add('active');
		};

		const move = (at) => {
			const acrossX = at.clientX - down.clientX;
			const acrossY = at.clientY - down.clientY;
			if (!axis) {
				if (Math.abs(acrossX) < axisThreshold && Math.abs(acrossY) < axisThreshold) return;
				axis = lane !== null && Math.abs(acrossY) > Math.abs(acrossX) ? 'lane' : 'time';
			}
			if (axis === 'lane') {
				dropTarget(at);
				return;
			}
			const shift = acrossX * perPixel;
			start = item.start_unix + (grip === 'end' ? 0 : shift);
			end = item.end_unix + (grip === 'start' ? 0 : shift);
			if (end - start < daySeconds) {
				if (grip === 'start') start = end - daySeconds; else end = start + daySeconds;
			}
			drawn.style.left = `${percent(span, start)}%`;
			drawn.style.width = `${Math.max(percent(span, end) - percent(span, start), 1)}%`;
			// The day this drag will write, while it is being dragged: at a coarse ruler one
			// pixel is several days, so a gesture whose result appears only on release is a
			// gesture that writes the wrong day.
			readout.start.textContent = day(start);
			readout.end.textContent = day(end);
		};

		const up = async (at) => {
			drawn.releasePointerCapture(at.pointerId);
			drawn.removeEventListener('pointermove', move);
			drawn.removeEventListener('pointerup', up);
			drawn.style.cursor = 'grab';

			if (axis === 'lane') {
				const dropped = target ? target.dataset.lane : null;
				if (target) target.classList.remove('active');
				if (dropped === null || dropped === lane) {
					load();
					return;
				}
				await write(laneMovePath.replace('{issue_id}', String(item.issue_id)),
					{repo: repoFullName, group_by: groupBy, lane: dropped});
				return;
			}

			const patch = {repo: repoFullName};
			if (grip !== 'end' && day(start) !== day(item.start_unix)) patch.start = day(start);
			if (grip !== 'start' && day(end) !== day(item.end_unix)) patch.end = day(end);
			if (!patch.start && !patch.end) {
				load();
				return;
			}
			await write(`/timeline/issues/${item.issue_id}/dates`, patch);
		};

		drawn.style.cursor = 'grabbing';
		drawn.setPointerCapture(down.pointerId);
		drawn.addEventListener('pointermove', move);
		drawn.addEventListener('pointerup', up);
	});
}

// rowSelect is the milestone cell: a chart whose rows can only be read is half a chart.
function rowSelect(item) {
	const td = document.createElement('td');
	if (!canWrite) {
		td.textContent = item.milestone || '—';
		return td;
	}
	const select = document.createElement('select');
	select.className = 'ui dropdown';
	select.append(new Option('—', '0', false, !item.milestone_id));
	for (const row of rows) {
		select.append(new Option(row.title, String(row.milestone_id), false, row.milestone_id === item.milestone_id));
	}
	select.addEventListener('change', () => {
		write(`/timeline/issues/${item.issue_id}/milestone`,
			{repo: repoFullName, milestone_id: Number(select.value)});
	});
	td.append(select);
	return td;
}

function sourceNote(item) {
	return `${item.start_source} → ${item.end_source}${item.end_inferred ? ' (inferred)' : ' (recorded)'}`;
}

// A hard gate the forge acts on and a sequencing hint it does not are labelled differently,
// because they do not read the same on a schedule.
function arrowsCell(tr, payload, arrows) {
	return cell(tr, arrows.length
		? arrows.map((a) => `${arrowLabel(payload, a.from_issue_id)} ${a.enforced ? '(gate)' : '(sequence)'}`).join(', ')
		: '—');
}

// arrowLabel names the other end of an edge by what the chart is actually showing, never by
// an issue id dressed up as an issue number.
function arrowLabel(payload, issueID) {
	const found = payload.bars.find((b) => b.issue_id === issueID);
	if (found) return `#${found.number}`;
	const span = payload.spans.find((s) => s.issue_id === issueID);
	if (span) return `${span.kind} ${span.label}`;
	return `issue ${issueID}`;
}

function warningCell(tr, row) {
	if (!row || !row.warning) {
		cell(tr, '—');
		return;
	}
	tr.classList.add('warning');
	cell(tr, `${row.warning} — ${row.suggested_action}`);
}

function childCount(row) {
	// A fraction of an unknown denominator is not a measurement, so a partial rollup says
	// what it loaded instead of printing a percentage.
	return row.partial
		? `${row.children} children loaded, more exist`
		: `${row.children} children, ${row.progress}% closed`;
}

// bracketRow is one rolled-up row of the chart. Clicking it descends into the work it covers.
function bracketRow(payload, span, row, blockers) {
	const tr = document.createElement('tr');
	const label = document.createElement('td');
	const open = document.createElement('button');
	open.type = 'button';
	open.className = 'ui basic compact button';
	open.textContent = `${row.kind}: ${row.label}`;
	open.title = `show the issues under ${row.label}`;
	open.addEventListener('click', () => descend(row));
	label.append(open);
	tr.append(label);

	cell(tr, childCount(row));
	cell(tr, day(row.start_unix));
	cell(tr, day(row.end_unix));

	const td = document.createElement('td');
	const container = track();
	const drawn = bracket(container, span, row);
	drawn.addEventListener('click', () => descend(row));
	drawn.classList.add('tw-cursor-pointer');
	td.append(container);
	tr.append(td);

	arrowsCell(tr, payload, blockers.get(row.issue_id) ?? []);
	warningCell(tr, row);
	return tr;
}

// barRow is one issue. An epic carries two windows, so its own bar is drawn with the bracket
// its children derive beneath it in the same cell: the gap between the two is the warning.
function barRow(payload, span, item, blockers, derived, lane) {
	const tr = document.createElement('tr');
	const issue = document.createElement('td');
	const link = document.createElement('a');
	link.href = `${subURL}${item.url}`;
	link.textContent = `#${item.number} ${item.title}`;
	issue.append(link);
	tr.append(issue);

	tr.append(rowSelect(item));
	const readout = {
		start: cell(tr, `${day(item.start_unix)} (${item.start_source})`),
		end: cell(tr, `${day(item.end_unix)} (${item.end_source})`),
	};

	const td = document.createElement('td');
	td.title = sourceNote(item);
	const container = track();
	bar(container, span, item, readout, lane);
	td.append(container);
	const rollup = derived.get(item.issue_id);
	if (rollup) {
		const under = track();
		bracket(under, span, rollup);
		td.append(under);
	}
	tr.append(td);

	arrowsCell(tr, payload, blockers.get(item.issue_id) ?? []);
	warningCell(tr, rollup);
	return tr;
}

// laneHeading is the drop target a vertical drag lands on. A reader gets the heading and no
// target, because a reader has nothing to drop.
function laneHeading(lane) {
	const tr = document.createElement('tr');
	tr.className = 'delivery-lane';
	if (canWrite) tr.dataset.lane = lane.key;
	const th = document.createElement('th');
	th.colSpan = columns;
	th.textContent = `${lane.label} (${lane.cards})`;
	if (lane.is_empty_value) {
		th.append(Object.assign(document.createElement('div'), {
			className: 'tw-text-12 tw-font-normal',
			textContent: 'no value for this grouping',
		}));
	}
	tr.append(th);
	return tr;
}

function statement(payload) {
	if (!payload.truncated) {
		truncatedBox.classList.add('tw-hidden');
		return;
	}
	const count = payload.zoom === 'issue' ? payload.bars.length : payload.spans.length;
	const what = payload.zoom === 'issue' ? 'issues' : `${payload.zoom} rollups`;
	document.querySelector('#delivery-truncated-message').textContent =
		`This chart is the first ${count} ${what}; narrow by epic or state to see the rest.`;
	truncatedBox.classList.remove('tw-hidden');
}

function render(payload) {
	canWrite = payload.can_write;
	rows = payload.rows;
	repoFullName = payload.repo_full_name;
	groupBy = payload.group_by;
	zoom = payload.zoom;
	zoomSelect.value = zoom;
	groupSelect.value = groupBy;
	document.querySelector('#delivery-edit').classList.toggle('tw-hidden', !canWrite);
	document.querySelector('#delivery-new-issue-row').replaceChildren(new Option('—', '0'),
		...rows.map((row) => new Option(row.title, String(row.milestone_id))));
	const milestone = milestoneSelect.value;
	milestoneSelect.replaceChildren(new Option('all', '0'),
		...rows.map((row) => new Option(row.title, String(row.milestone_id))));
	milestoneSelect.value = milestone;
	if (!milestoneSelect.value) milestoneSelect.value = '0'; // the milestone it named is gone

	statement(payload);
	const span = chartSpan(payload);
	drawRuler(payload, span);

	const blockers = new Map();
	for (const arrow of payload.arrows) {
		const list = blockers.get(arrow.to_issue_id) ?? [];
		list.push(arrow);
		blockers.set(arrow.to_issue_id, list);
	}

	if (zoom === 'issue') {
		// An epic's derived window belongs beside its own bar, keyed by the issue the
		// rollup names.
		const derived = new Map(payload.spans
			.filter((row) => row.kind === 'epic' && row.issue_id)
			.map((row) => [row.issue_id, row]));
		const laneOf = new Map();
		for (const lane of payload.lanes) {
			for (const column of lane.columns) {
				for (const card of column.cards) laneOf.set(card.issue_id, lane.key);
			}
		}

		if (!payload.bars.length) {
			body.replaceChildren(emptyRow('no issue in this repository carries an epic label, so there is nothing to draw'));
		} else if (payload.lanes.length) {
			const grouped = [];
			for (const lane of payload.lanes) {
				grouped.push(laneHeading(lane));
				for (const item of payload.bars) {
					if (laneOf.get(item.issue_id) === lane.key) {
						grouped.push(barRow(payload, span, item, blockers, derived, lane.key));
					}
				}
			}
			body.replaceChildren(...grouped);
		} else {
			body.replaceChildren(...payload.bars.map((item) => barRow(payload, span, item, blockers, derived, null)));
		}
	} else if (!payload.spans.length) {
		body.replaceChildren(emptyRow(`nothing is filed under a ${zoom} in this repository, so there is nothing to draw`));
	} else {
		body.replaceChildren(...payload.spans.map((row) => bracketRow(payload, span, row, blockers)));
	}

	spansBody.replaceChildren(...(payload.spans.length ? payload.spans.map((row) => {
		const tr = document.createElement('tr');
		cell(tr, `${row.kind}: ${row.label}`);
		cell(tr, `${day(row.start_unix)} → ${day(row.end_unix)}`);
		cell(tr, childCount(row));
		cell(tr, row.end_inferred ? 'contains an inferred end' : 'every end recorded');
		return tr;
	}) : [emptyRow('—', 4)]));

	unmanagedBody.replaceChildren(...(payload.unmanaged.length ? payload.unmanaged.map((item) => {
		const tr = document.createElement('tr');
		const issue = document.createElement('td');
		const link = document.createElement('a');
		link.href = `${subURL}${item.url}`;
		link.textContent = `#${item.number} ${item.title}`;
		issue.append(link);
		tr.append(issue);
		cell(tr, item.reason);
		cell(tr, item.suggested_action);
		return tr;
	}) : [emptyRow('—', 3)]));
}

function emptyRow(text, span = columns) {
	const tr = document.createElement('tr');
	cell(tr, text).colSpan = span;
	return tr;
}

async function load() {
	const repoID = repoInput.value.trim();
	if (!repoID) {
		fail('a timeline covers one repository', 'Enter the repository id; the delivery API lists them at /repos.');
		return;
	}
	const params = new URLSearchParams({
		repo_id: repoID, state: stateSelect.value, limit: '200',
		zoom: zoomSelect.value, group_by: groupSelect.value,
	});
	if (epicInput.value.trim()) params.set('epic', epicInput.value.trim());
	if (milestoneSelect.value !== '0') params.set('milestone_id', milestoneSelect.value);

	let payload;
	try {
		const resp = await fetch(`${base}/timeline?${params}`, {headers: headers()});
		payload = await resp.json();
		if (!resp.ok) {
			if (resp.status === 401 || resp.status === 403) tokenBox.classList.remove('tw-hidden');
			fail(payload.message ?? `the API returned ${resp.status}`,
				payload.suggested_action ?? 'Retry, and check the server log if it keeps failing.');
			return;
		}
	} catch (err) {
		fail(String(err), `Check that you are signed in and that the delivery API is reachable at ${base}.`);
		return;
	}

	clearError();
	tokenBox.classList.add('tw-hidden');
	render(payload);
}

// write posts one of the chart's edits. Every write endpoint answers with the chart it
// produced, so the page renders the response rather than re-fetching and hoping — except
// when that chart is not the one on screen: a write that states no view answers at issue
// zoom with no grouping, and rendering it would silently change the view the reader chose.
async function write(path, patch) {
	let payload;
	try {
		const resp = await fetch(`${base}${path}`, {
			method: 'POST',
			headers: {...headers(), 'content-type': 'application/json'},
			body: JSON.stringify(patch),
		});
		payload = await resp.json();
		if (!resp.ok) {
			if (resp.status === 401 || resp.status === 403) tokenBox.classList.remove('tw-hidden');
			fail(payload.message ?? `the API returned ${resp.status}`,
				payload.suggested_action ?? 'Reload the chart and try again.');
			load();
			return;
		}
	} catch (err) {
		fail(String(err), `Check that the delivery API is reachable at ${base}.`);
		load();
		return;
	}
	clearError();
	if (payload.zoom !== zoomSelect.value || payload.group_by !== groupSelect.value ||
		epicInput.value.trim() || milestoneSelect.value !== '0') {
		load();
		return;
	}
	render(payload);
}

document.querySelector('#delivery-add-row').addEventListener('click', () => {
	const title = document.querySelector('#delivery-new-row').value.trim();
	if (!title) {
		fail('a row needs a title', 'Type a milestone title, then press Add row.');
		return;
	}
	write('/timeline/milestones', {
		repo: repoFullName, title, end: document.querySelector('#delivery-new-row-end').value,
	}).then(() => {
		document.querySelector('#delivery-new-row').value = '';
	});
});

document.querySelector('#delivery-add-issue').addEventListener('click', () => {
	const title = document.querySelector('#delivery-new-issue').value.trim();
	if (!title) {
		fail('an issue needs a title', 'Type a title, then press Add issue.');
		return;
	}
	write('/timeline/issues', {
		repo: repoFullName, title,
		epic: document.querySelector('#delivery-new-issue-epic').value.trim(),
		milestone_id: Number(document.querySelector('#delivery-new-issue-row').value),
	}).then(() => {
		document.querySelector('#delivery-new-issue').value = '';
	});
});

document.querySelector('#delivery-token-save').addEventListener('click', () => {
	try {
		window.sessionStorage.setItem(tokenKey, tokenInput.value.trim());
	} catch {
		fail('this browser refused to keep the token for this tab',
			'Allow site data for this origin, or use the gitea-delivery CLI instead.');
		return;
	}
	load();
});
document.querySelector('#delivery-load').addEventListener('click', load);
zoomSelect.addEventListener('change', load);
groupSelect.addEventListener('change', load);
milestoneSelect.addEventListener('change', load);
</script>
