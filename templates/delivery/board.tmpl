{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard delivery">
	<div class="ui container">
		<h2 class="ui header">{{.Title}}</h2>
		<p class="tw-text-14">
			Gitea's project columns run across; the lanes run down. Gitea models no lane at all —
			<code>project.Column</code> carries a title, a sort order, a colour and a project and nothing
			else — so a lane is a rendering over rows the API already returns. Grouping is a view
			setting, never stored on the board, so two people may group the same board differently.
			Every figure is fetched from <code>{{.DeliveryAPIBase}}/board</code>; this page is a client
			of that endpoint and reads nothing the API does not serve.
		</p>

		<div class="ui form">
			<div class="inline fields">
				<div class="field">
					<label for="delivery-repo">Repository id</label>
					<input id="delivery-repo" type="number" min="1" size="6">
				</div>
				<div class="field">
					<label for="delivery-project">Board id</label>
					<input id="delivery-project" type="number" min="1" size="6">
				</div>
				<div class="field">
					<label for="delivery-group">Lanes by</label>
					<select id="delivery-group" class="ui dropdown">
						{{range .Groupings}}<option value="{{.}}">{{.}}</option>{{end}}
					</select>
				</div>
				<div class="field">
					<button id="delivery-load" class="ui primary button" type="button">Show board</button>
				</div>
			</div>
		</div>

		<div id="delivery-error" class="ui negative message tw-hidden">
			<div class="header">Could not load the board</div>
			<p id="delivery-error-message"></p>
			<p><strong>Suggested action:</strong> <span id="delivery-error-action"></span></p>
		</div>

		<div id="delivery-token-box" class="ui warning message tw-hidden">
			<div class="header">This page needs an API token</div>
			<p>
				The delivery API authenticates with a token, not with your browser session, so no card
				can be moved by another site holding your cookie. Create one under Settings &gt;
				Applications and paste it here; it is kept in this tab only.
			</p>
			<div class="ui action input">
				<input id="delivery-token" type="password" autocomplete="off" placeholder="API token">
				<button id="delivery-token-save" class="ui primary button" type="button">Use token</button>
			</div>
		</div>

		<h3 id="delivery-board-title" class="ui header tw-hidden"></h3>
		<div class="tw-overflow-x-auto">
			<table class="ui celled table" id="delivery-board">
				<thead><tr id="delivery-board-head"></tr></thead>
				<tbody id="delivery-board-body">
					<tr><td>Name a repository and a board, then press Show board.</td></tr>
				</tbody>
			</table>
		</div>

		<p class="tw-text-12">
			Two writes exist on this board and no others: moving a card between columns, and moving it
			between lanes, which edits the grouping field itself — the <code>type:</code> label, the
			<code>epic:</code> label or the assignee. A lane move is refused when grouping is off,
			because there is then nothing to write.
		</p>
	</div>
</div>
<script type="module">
const base = {{.DeliveryAPIBase}};
const subURL = {{.AppSubURL}};

// The documented operation paths for the two writes, spelled exactly as the published
// document spells them, so this page names the endpoints it is a client of rather than a
// rewritten copy of them.
const columnMovePath = '/board/cards/{issue_id}/column';
const laneMovePath = '/board/cards/{issue_id}/lane';

const head = document.querySelector('#delivery-board-head');
const body = document.querySelector('#delivery-board-body');
const heading = document.querySelector('#delivery-board-title');
const tokenBox = document.querySelector('#delivery-token-box');
const tokenInput = document.querySelector('#delivery-token');
const repoInput = document.querySelector('#delivery-repo');
const projectInput = document.querySelector('#delivery-project');
const groupSelect = document.querySelector('#delivery-group');

const tokenKey = 'delivery-api-token';
function storedToken() {
	try {
		return window.sessionStorage.getItem(tokenKey) ?? '';
	} catch {
		return '';
	}
}

function headers(withBody) {
	const out = {accept: 'application/json'};
	if (withBody) out['content-type'] = 'application/json';
	const token = storedToken();
	if (token) out.authorization = `token ${token}`;
	return out;
}

function fail(message, action) {
	document.querySelector('#delivery-error-message').textContent = message;
	document.querySelector('#delivery-error-action').textContent = action;
	document.querySelector('#delivery-error').classList.remove('tw-hidden');
}

function clearError() {
	document.querySelector('#delivery-error').classList.add('tw-hidden');
}

let current = null;

// render lays the board out as lanes down and columns across. Every lane carries every
// column, so the table is a rectangle whatever the grouping.
function render(board) {
	current = board;
	heading.textContent = `${board.title} — ${board.repo_full_name}`;
	heading.classList.remove('tw-hidden');

	const laneHeader = document.createElement('th');
	laneHeader.textContent = board.group_by === 'none' ? '' : board.group_by;
	head.replaceChildren(laneHeader);
	for (const column of board.columns) {
		const th = document.createElement('th');
		th.textContent = column.title;
		head.append(th);
	}

	body.replaceChildren(...board.lanes.map((lane) => {
		const tr = document.createElement('tr');
		const laneCell = document.createElement('th');
		laneCell.textContent = lane.label;
		if (lane.is_empty_value) {
			// O3: the empty-value lane is explicit. It reads as a fact about the issues,
			// not as a blank row.
			laneCell.append(Object.assign(document.createElement('div'), {
				className: 'tw-text-12',
				textContent: 'no value for this grouping',
			}));
		}
		tr.append(laneCell);

		for (const column of lane.columns) {
			const td = document.createElement('td');
			td.append(...column.cards.map((card) => cardElement(board, lane, card)));
			if (!column.cards.length) td.textContent = '—';
			tr.append(td);
		}
		return tr;
	}));
}

function cardElement(board, lane, card) {
	const wrapper = document.createElement('div');
	wrapper.className = 'tw-mb-2';

	const link = document.createElement('a');
	link.href = `${subURL}${card.url}`;
	link.textContent = `#${card.number} ${card.title}`;
	wrapper.append(link);

	if (board.can_write && board.columns.length > 1) {
		wrapper.append(move('column', board.columns.map((c) => [String(c.column_id), c.title]),
			String(card.column_id), (value) => moveColumn(card, Number(value))));
	}
	if (board.can_edit_issue && board.group_by !== 'none') {
		const lanes = board.lanes.map((l) => [l.key, l.label]);
		wrapper.append(move('lane', lanes, lane.key, (value) => moveLane(card, value)));
	}
	return wrapper;
}

function move(name, options, selected, onChange) {
	const select = document.createElement('select');
	select.className = 'ui dropdown tw-ml-2';
	select.title = `move this card to another ${name}`;
	for (const [value, label] of options) {
		const option = document.createElement('option');
		option.value = value;
		option.textContent = label;
		if (value === selected) option.selected = true;
		select.append(option);
	}
	select.addEventListener('change', () => onChange(select.value));
	return select;
}

async function post(path, payload) {
	clearError();
	const resp = await fetch(`${base}${path}`, {
		method: 'POST', headers: headers(true), body: JSON.stringify(payload),
	});
	const data = await resp.json().catch(() => ({}));
	if (!resp.ok) {
		if (resp.status === 401) tokenBox.classList.remove('tw-hidden');
		fail(data.message ?? `the API returned ${resp.status}`,
			data.suggested_action ?? 'Retry, and check the server log if it keeps failing.');
		return;
	}
	render(data);
}

function moveColumn(card, columnID) {
	return post(columnMovePath.replace('{issue_id}', String(card.issue_id)), {
		repo: current.repo_full_name, project_id: current.project_id,
		column_id: columnID, group_by: current.group_by,
	});
}

function moveLane(card, lane) {
	return post(laneMovePath.replace('{issue_id}', String(card.issue_id)), {
		repo: current.repo_full_name, project_id: current.project_id,
		group_by: current.group_by, lane,
	});
}

async function load() {
	const repoID = repoInput.value.trim();
	const projectID = projectInput.value.trim();
	if (!repoID || !projectID) {
		fail('a board belongs to one repository, so both ids are needed',
			'Enter the repository id and the board id. An epic sync records the board id as .board.number in the epic sync-manifest.json.');
		return;
	}
	const params = new URLSearchParams({repo_id: repoID, project_id: projectID, group_by: groupSelect.value});

	let payload;
	try {
		const resp = await fetch(`${base}/board?${params}`, {headers: headers(false)});
		payload = await resp.json();
		if (!resp.ok) {
			if (resp.status === 401) tokenBox.classList.remove('tw-hidden');
			// A build without the Projects API, or a repository with the unit switched
			// off, answers here with the reason and what to do about it — the board
			// degrades rather than breaking, and the timeline still renders.
			fail(payload.message ?? `the API returned ${resp.status}`,
				payload.suggested_action ?? 'Retry, and check the server log if it keeps failing.');
			body.replaceChildren();
			head.replaceChildren();
			heading.classList.add('tw-hidden');
			return;
		}
	} catch (err) {
		fail(String(err), `Check that you are signed in and that the delivery API is reachable at ${base}.`);
		return;
	}

	clearError();
	tokenBox.classList.add('tw-hidden');
	render(payload);
}

document.querySelector('#delivery-token-save').addEventListener('click', () => {
	try {
		window.sessionStorage.setItem(tokenKey, tokenInput.value.trim());
	} catch {
		fail('this browser refused to keep the token for this tab',
			'Allow site data for this origin, or use the gitea-delivery CLI instead.');
		return;
	}
	load();
});
document.querySelector('#delivery-load').addEventListener('click', load);
groupSelect.addEventListener('change', () => {
	if (current) load();
});
</script>
{{template "base/footer" .}}
