{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard delivery">
	<div class="ui container">
		{{if .EnvironmentID}}
			<h2 class="ui header" id="delivery-heading">Environment</h2>
			<p class="tw-text-14">
				Every figure below is fetched from <code>{{.DeliveryAPIBase}}/environments</code>. This
				page is a client of that endpoint and reads nothing the API does not serve. A secret is
				listed by name; no endpoint returns a value.
			</p>

			<p class="tw-text-14">
				<a id="delivery-grid-link" href="{{.AppSubURL}}/delivery/grid">Deployments to this environment</a>
				·
				<a id="delivery-approvals-link" href="{{.AppSubURL}}/delivery/approvals">Pending approvals</a>
			</p>

			<div id="delivery-error" class="ui negative message tw-hidden">
				<div class="header">Could not load this environment</div>
				<p id="delivery-error-message"></p>
				<p><strong>Suggested action:</strong> <span id="delivery-error-action"></span></p>
			</div>

			<div id="delivery-token-box" class="ui warning message tw-hidden">
				<div class="header">Editing from here needs an API token</div>
				<p>
					Reads use your browser session, but a write never does, so that no other site holding
					your cookie can reconfigure a gate. Create a token under Settings &gt; Applications and
					paste it here; it is kept in this tab only.
				</p>
				<div class="ui action input">
					<input id="delivery-token" type="password" autocomplete="off" placeholder="API token">
					<button id="delivery-token-save" class="ui primary button" type="button">Use token</button>
				</div>
			</div>

			<div id="delivery-detail" class="tw-hidden">
				<div class="ui form">
					<div class="inline fields">
						<div class="field">
							<label for="delivery-name">Name</label>
							<input id="delivery-name" type="text" size="20">
						</div>
						<div class="field">
							<label for="delivery-order">Order</label>
							<input id="delivery-order" type="number" size="6">
						</div>
						<div class="field" id="delivery-identity-actions"></div>
					</div>
				</div>

				<h3 class="ui header">Checks</h3>
				<div class="ui form" id="delivery-add-check-form"></div>
				<div id="delivery-checks"></div>

				<div id="delivery-secrets-section" class="tw-hidden">
					<h3 class="ui header">Secrets</h3>
					<div id="delivery-secrets"></div>
					<div class="ui form" id="delivery-bind-form"></div>
				</div>

				<div id="delivery-danger" class="tw-hidden">
					<h3 class="ui header">Danger zone</h3>
					<div class="ui form" id="delivery-danger-form"></div>
				</div>
			</div>
		{{else}}
			<h2 class="ui header">{{.Title}}</h2>
			<p class="tw-text-14">
				Every figure below is fetched from <code>{{.DeliveryAPIBase}}/environments</code>. This
				page is a client of that endpoint and reads nothing the API does not serve.
			</p>

			<div id="delivery-error" class="ui negative message tw-hidden">
				<div class="header">Could not load environments</div>
				<p id="delivery-error-message"></p>
				<p><strong>Suggested action:</strong> <span id="delivery-error-action"></span></p>
			</div>

			<div id="delivery-token-box" class="ui warning message tw-hidden">
				<div class="header">Creating an environment needs an API token</div>
				<p>
					Reads use your browser session, but a write never does. Create a token under Settings
					&gt; Applications and paste it here; it is kept in this tab only.
				</p>
				<div class="ui action input">
					<input id="delivery-token" type="password" autocomplete="off" placeholder="API token">
					<button id="delivery-token-save" class="ui primary button" type="button">Use token</button>
				</div>
			</div>

			<div id="delivery-new" class="ui segment tw-hidden">
				<div class="ui form">
					<div class="inline fields">
						<div class="field">
							<label for="delivery-new-name">Environment name</label>
							<input id="delivery-new-name" type="text" size="18" placeholder="staging">
						</div>
						<div class="field">
							<label for="delivery-new-repo">Repository</label>
							<input id="delivery-new-repo" type="text" size="24" placeholder="owner/name — blank for instance-wide">
						</div>
						<div class="field">
							<button id="delivery-create" class="ui primary button" type="button">New environment</button>
						</div>
					</div>
				</div>
			</div>

			<table class="ui table" id="delivery-environments">
				<thead>
					<tr>
						<th>Name</th>
						<th>Scope</th>
						<th>Order</th>
						<th>Checks</th>
						<th></th>
					</tr>
				</thead>
				<tbody id="delivery-environments-body">
					<tr><td colspan="5">Loading…</td></tr>
				</tbody>
			</table>
		{{end}}
	</div>
</div>
<script type="module" nonce="{{ctx.CspScriptNonce}}">
const base = {{.DeliveryAPIBase}};
const subURL = {{.AppSubURL}};
const pageToken = {{.DeliveryPageToken}};
const wanted = {{.EnvironmentName}};
const envID = {{.EnvironmentID}};
const gitea = `${subURL}/api/v1`;

// The documented operation paths, spelled as the published document spells them.
const environmentPath = '/environments/{id}';
const secretScopePath = '/secret-scopes/{id}';
const environmentSecretsPath = '/repos/{owner}/{repo}/environments/{name}/secrets';
const envPath = environmentPath.replace('{id}', envID);

const tokenBox = document.querySelector('#delivery-token-box');
const tokenKey = 'delivery-api-token';

function storedToken() {
	try {
		return window.sessionStorage.getItem(tokenKey) ?? pageToken ?? '';
	} catch {
		return pageToken ?? '';
	}
}

function headers() {
	const out = {accept: 'application/json'};
	const token = storedToken();
	if (token) out.authorization = `token ${token}`;
	return out;
}

function fail(message, action) {
	document.querySelector('#delivery-error-message').textContent = message;
	document.querySelector('#delivery-error-action').textContent = action;
	document.querySelector('#delivery-error').classList.remove('tw-hidden');
}

function clearError() {
	document.querySelector('#delivery-error').classList.add('tw-hidden');
}

// probe answers null on a refusal, so a picker is offered only where the call works.
async function probe(url) {
	try {
		const resp = await fetch(url, {headers: headers()});
		if (!resp.ok) return null;
		return await resp.json();
	} catch {
		return null;
	}
}

async function write(method, path, payload) {
	let body = null;
	try {
		const init = {method, headers: headers()};
		if (payload !== undefined) {
			init.headers = {...init.headers, 'content-type': 'application/json'};
			init.body = JSON.stringify(payload);
		}
		const resp = await fetch(`${base}${path}`, init);
		if (resp.status !== 204) body = await resp.json().catch(() => null);
		if (!resp.ok) {
			if (resp.status === 401 || resp.status === 403) tokenBox.classList.remove('tw-hidden');
			fail(body?.message ?? `the API returned ${resp.status}`,
				body?.suggested_action ?? 'Retry, and check the server log if it keeps failing.');
			return null;
		}
	} catch (err) {
		fail(String(err), `Check that the delivery API is reachable at ${base}.`);
		return null;
	}
	clearError();
	tokenBox.classList.add('tw-hidden');
	return body ?? {};
}

function el(tag, className, text) {
	const node = document.createElement(tag);
	if (className) node.className = className;
	if (text !== undefined) node.textContent = text;
	return node;
}

function button(label, className, onClick) {
	const node = el('button', `ui ${className} button`, label);
	node.type = 'button';
	node.addEventListener('click', onClick);
	return node;
}

function link(text, href) {
	const node = el('a', '', text);
	node.href = href;
	return node;
}

// checks is the check model: presence, summary, and what add and remove do to the row.
const checks = [
	{
		key: 'approvals',
		label: 'Approvals',
		present: (env) => env.approval_policy !== 'none',
		summary: (env) => `${env.required_approvals} approval${env.required_approvals === 1 ? '' : 's'}`
			+ (env.approval_policy === 'others_only'
				? ', and not from whoever asked for the deploy'
				: ', from anyone with write on Actions'),
		add: (draft) => {
			draft.approval_policy = 'any_approver';
			draft.required_approvals = 1;
		},
		remove: (draft) => {
			draft.approval_policy = 'none';
			draft.required_approvals = 1;
		},
		editor: approvalsEditor,
	},
	{
		key: 'sequence',
		label: 'Sequence',
		present: (env) => env.predecessor !== '',
		summary: (env) => `a release must have passed through ${env.predecessor} first`
			+ (env.require_predecessor ? '' : ' — a deploy that skips it is warned about, not refused'),
		add: () => {}, // the editor picks the predecessor; refusing is off until a writer asks for it
		remove: (draft) => {
			draft.predecessor = '';
			draft.require_predecessor = false;
		},
		editor: sequenceEditor,
	},
	{
		key: 'release_kind',
		label: 'Release kind',
		present: (env) => env.require_full_release,
		summary: () => 'prereleases are refused here',
		add: (draft) => {
			draft.require_full_release = true;
		},
		remove: (draft) => {
			draft.require_full_release = false;
		},
		editor: releaseKindEditor,
	},
	{
		key: 'bypass',
		label: 'Bypass allowlist',
		present: (env) => env.enable_bypass_allowlist,
		summary: (env) => `${env.bypass_allowlist_user_ids.length} user`
			+ `${env.bypass_allowlist_user_ids.length === 1 ? '' : 's'} and `
			+ `${env.bypass_allowlist_team_ids.length} team`
			+ `${env.bypass_allowlist_team_ids.length === 1 ? '' : 's'} decide`
			+ (env.block_admin_override ? '; admins cannot override' : '; an administrator may still override'),
		add: (draft) => {
			draft.enable_bypass_allowlist = true;
		},
		remove: (draft) => {
			draft.enable_bypass_allowlist = false;
			draft.bypass_allowlist_user_ids = [];
			draft.bypass_allowlist_team_ids = [];
			draft.block_admin_override = false;
		},
		editor: bypassEditor,
	},
];

function normalize(env) {
	return {
		...env,
		predecessor: env.predecessor ?? '',
		bypass_allowlist_user_ids: env.bypass_allowlist_user_ids ?? [],
		bypass_allowlist_team_ids: env.bypass_allowlist_team_ids ?? [],
	};
}

function payloadOf(env) {
	return {
		repo_id: env.repo_id,
		name: env.name,
		sort_order: env.sort_order,
		approval_policy: env.approval_policy,
		required_approvals: env.required_approvals,
		predecessor: env.predecessor,
		require_predecessor: env.require_predecessor,
		require_full_release: env.require_full_release,
		block_admin_override: env.block_admin_override,
		enable_bypass_allowlist: env.enable_bypass_allowlist,
		bypass_allowlist_user_ids: env.bypass_allowlist_user_ids,
		bypass_allowlist_team_ids: env.bypass_allowlist_team_ids,
	};
}

function labelled(form, text, id) {
	const wrap = el('div', 'field');
	const label = el('label', '', text);
	label.htmlFor = id;
	wrap.append(label);
	form.append(wrap);
	return wrap;
}

function textField(form, text, id, type) {
	const input = el('input');
	input.id = id;
	input.type = type;
	labelled(form, text, id).append(input);
	return input;
}

function selectField(form, text, id, options) {
	const node = el('select');
	node.id = id;
	for (const [value, label] of options) {
		const option = el('option', '', label);
		option.value = value;
		node.append(option);
	}
	labelled(form, text, id).append(node);
	return node;
}

function checkField(form, text, id) {
	const input = el('input');
	input.id = id;
	input.type = 'checkbox';
	const wrap = el('div', 'field');
	const label = el('label', '', ` ${text}`);
	label.htmlFor = id;
	wrap.append(input, label);
	form.append(wrap);
	return input;
}

function approvalsEditor(draft) {
	const form = el('div', 'ui form');
	const count = textField(form, 'Required approvals', 'delivery-required-approvals', 'number');
	count.min = '1';
	count.value = String(draft.required_approvals || 1);
	count.addEventListener('input', () => {
		draft.required_approvals = Number(count.value);
	});
	const policy = selectField(form, 'Who may approve', 'delivery-approval-policy', [
		['any_approver', 'anyone with write on Actions'],
		['others_only', 'anyone except whoever asked'],
	]);
	policy.value = draft.approval_policy === 'others_only' ? 'others_only' : 'any_approver';
	policy.addEventListener('change', () => {
		draft.approval_policy = policy.value;
	});
	return form;
}

function sequenceEditor(draft, state) {
	const form = el('div', 'ui form');
	const candidates = state.siblings.filter((env) => env.name !== state.env.name);
	if (!candidates.length) {
		form.append(el('p', 'tw-text-14',
			'No other environment shares this scope, so there is nothing a release could pass through first. '
			+ 'Create a second environment in this scope, then add this check.'));
		return form;
	}
	const picker = selectField(form, 'Predecessor', 'delivery-predecessor',
		candidates.map((env) => [env.name, env.name]));
	if (!draft.predecessor) draft.predecessor = candidates[0].name;
	picker.value = draft.predecessor;
	picker.addEventListener('change', () => {
		draft.predecessor = picker.value;
	});
	const strict = checkField(form, 'refuse a deploy whose predecessor has never held the release',
		'delivery-require-predecessor');
	strict.checked = draft.require_predecessor;
	strict.addEventListener('change', () => {
		draft.require_predecessor = strict.checked;
	});
	return form;
}

function releaseKindEditor(draft) {
	const form = el('div', 'ui form');
	const box = checkField(form, 'refuse prereleases; this environment takes finished releases only',
		'delivery-require-full-release');
	box.checked = draft.require_full_release;
	box.addEventListener('change', () => {
		draft.require_full_release = box.checked;
	});
	return form;
}

function bypassEditor(draft, state) {
	const form = el('div', 'ui form');

	const users = el('div', 'field');
	users.append(el('label', '', 'Users who may bypass'));
	const chips = el('div', 'tw-flex tw-gap-2 tw-flex-wrap');
	const drawUsers = () => {
		chips.replaceChildren(...draft.bypass_allowlist_user_ids.map((id) => {
			const chip = el('span', 'ui label', state.userNames.get(id) ?? `user ${id}`);
			chip.append(button('×', 'mini basic', () => {
				draft.bypass_allowlist_user_ids = draft.bypass_allowlist_user_ids.filter((other) => other !== id);
				drawUsers();
			}));
			return chip;
		}));
	};
	drawUsers();
	users.append(chips);
	form.append(users);

	const name = textField(form, 'Add a user', 'delivery-bypass-user', 'text');
	name.placeholder = 'username';
	form.append(button('Add user', 'basic', async () => {
		const username = name.value.trim();
		if (!username) return;
		const user = await probe(`${gitea}/users/${encodeURIComponent(username)}`);
		if (!user) {
			fail(`no user named ${username} is visible to you`, 'Check the username, or search for it under Explore > Users.');
			return;
		}
		state.userNames.set(user.id, user.login);
		if (!draft.bypass_allowlist_user_ids.includes(user.id)) draft.bypass_allowlist_user_ids.push(user.id);
		name.value = '';
		clearError();
		drawUsers();
	}));

	if (state.teams.length) {
		const picker = selectField(form, 'Teams who may bypass', 'delivery-bypass-teams',
			state.teams.map((team) => [String(team.id), team.name]));
		picker.multiple = true;
		for (const option of picker.options) {
			option.selected = draft.bypass_allowlist_team_ids.includes(Number(option.value));
		}
		picker.addEventListener('change', () => {
			draft.bypass_allowlist_team_ids = [...picker.selectedOptions].map((option) => Number(option.value));
		});
	}

	const block = checkField(form, 'a repository administrator cannot bypass this', 'delivery-block-admin-override');
	block.checked = draft.block_admin_override;
	block.addEventListener('change', () => {
		draft.block_admin_override = block.checked;
	});
	return form;
}

if (envID) {
	const detail = document.querySelector('#delivery-detail');
	const heading = document.querySelector('#delivery-heading');
	const nameInput = document.querySelector('#delivery-name');
	const orderInput = document.querySelector('#delivery-order');
	const identityActions = document.querySelector('#delivery-identity-actions');
	const addCheckForm = document.querySelector('#delivery-add-check-form');
	const checksBox = document.querySelector('#delivery-checks');
	const secretsSection = document.querySelector('#delivery-secrets-section');
	const secretsBox = document.querySelector('#delivery-secrets');
	const bindForm = document.querySelector('#delivery-bind-form');
	const dangerBox = document.querySelector('#delivery-danger');
	const dangerForm = document.querySelector('#delivery-danger-form');

	const state = {
		env: null,
		siblings: [],
		repo: null,
		teams: [],
		userNames: new Map(),
		secrets: [],
		available: null, // the repository's Actions secret names, or null where that call refuses
		editing: null,
	};

	function drawIdentity() {
		heading.textContent = state.env.name;
		const scope = el('div', 'sub header', state.repo ? state.repo.full_name : 'instance-wide');
		heading.append(scope);
		nameInput.value = state.env.name;
		orderInput.value = String(state.env.sort_order);
		nameInput.readOnly = !state.env.can_write;
		orderInput.readOnly = !state.env.can_write;
		document.querySelector('#delivery-approvals-link').href =
			`${subURL}/delivery/environments/${encodeURIComponent(state.env.name)}/approvals`;
		identityActions.replaceChildren();
		if (!state.env.can_write) return;
		identityActions.append(button('Save', 'primary', async () => {
			const next = {...state.env, name: nameInput.value.trim(), sort_order: Number(orderInput.value)};
			await save(next);
		}));
	}

	async function save(next) {
		const body = await write('PUT', envPath, payloadOf(next));
		if (!body) return false;
		state.env = normalize(body);
		state.editing = null;
		await loadSiblings();
		render();
		return true;
	}

	function drawAddCheck() {
		addCheckForm.replaceChildren();
		if (!state.env.can_write) return;
		const missing = checks.filter((check) => !check.present(state.env));
		if (!missing.length) return;
		const row = el('div', 'inline fields');
		addCheckForm.append(row);
		const picker = selectField(row, 'Add check', 'delivery-add-check',
			[['', 'Add check…'], ...missing.map((check) => [check.key, check.label])]);
		picker.addEventListener('change', () => {
			if (!picker.value) return;
			const check = checks.find((candidate) => candidate.key === picker.value);
			const draft = normalize(state.env);
			check.add(draft);
			state.editing = {key: check.key, draft};
			render();
		});
	}

	function drawCheckEditor(check) {
		const segment = el('div', 'ui segment');
		segment.dataset.check = check.key;
		segment.append(el('h4', 'ui header', check.label));
		const fields = check.editor(state.editing.draft, state);
		segment.append(fields);
		const actions = el('div', 'tw-flex tw-gap-2 tw-mt-2');
		if (fields.querySelector('input, select')) { // an editor with nothing to set offers no Save
			actions.append(button('Save', 'primary', async () => {
				await save(state.editing.draft);
			}));
		}
		actions.append(button('Cancel', 'basic', () => {
			state.editing = null;
			render();
		}));
		segment.append(actions);
		return segment;
	}

	function drawChecks() {
		const present = checks.filter((check) => check.present(state.env));
		const nodes = [];
		for (const check of present) {
			if (state.editing && state.editing.key === check.key) {
				nodes.push(drawCheckEditor(check));
				continue;
			}
			const segment = el('div', 'ui segment');
			segment.dataset.check = check.key;
			const head = el('div', 'tw-flex tw-items-center tw-justify-between');
			head.append(el('strong', '', check.label));
			const actions = el('div', 'tw-flex tw-gap-2');
			if (state.env.can_write) {
				actions.append(button('Edit', 'basic mini', () => {
					state.editing = {key: check.key, draft: normalize(state.env)};
					render();
				}));
				actions.append(button('Remove', 'basic mini', async () => {
					const draft = normalize(state.env);
					check.remove(draft);
					await save(draft);
				}));
			}
			head.append(actions);
			segment.append(head, el('div', 'tw-text-14', check.summary(state.env)));
			nodes.push(segment);
		}
		if (state.editing && !present.some((check) => check.key === state.editing.key)) {
			nodes.push(drawCheckEditor(checks.find((check) => check.key === state.editing.key)));
		}
		if (!nodes.length) {
			nodes.push(el('p', 'tw-text-14',
				'Nothing gates a deploy here. Anyone with write on Actions can deploy any release, in any order.'));
		}
		checksBox.replaceChildren(...nodes);
	}

	function drawSecrets() {
		if (!state.repo || state.secrets === null) {
			secretsSection.classList.add('tw-hidden');
			return;
		}
		secretsSection.classList.remove('tw-hidden');
		const rows = state.secrets.map((secret) => {
			const row = el('div', 'tw-flex tw-items-center tw-gap-2');
			row.append(el('strong', '', secret.name));
			row.append(el('span', 'tw-text-12',
				secret.exists
					? `only jobs declaring \`${state.env.name}\` see it`
					: 'bound, but no secret of this name exists in the repository'));
			if (state.env.can_write) {
				row.append(button('Unbind', 'basic mini', async () => {
					if (await write('DELETE', secretScopePath.replace('{id}', secret.id)) === null) return;
					await loadSecrets();
					render();
				}));
			}
			return row;
		});
		if (!rows.length) rows.push(el('p', 'tw-text-14', 'No secret is scoped to this environment.'));
		secretsBox.replaceChildren(...rows);

		bindForm.replaceChildren();
		if (!state.env.can_write) return;
		const row = el('div', 'inline fields');
		bindForm.append(row);
		const bound = new Set(state.secrets.map((secret) => secret.name));
		let read;
		if (state.available) {
			const free = state.available.filter((secret) => !bound.has(secret.name));
			const picker = selectField(row, 'Secret', 'delivery-secret-name',
				free.map((secret) => [secret.name, secret.name]));
			read = () => picker.value;
		} else {
			const input = textField(row, 'Secret', 'delivery-secret-name', 'text');
			input.placeholder = 'DEPLOY_KEY';
			read = () => input.value.trim();
		}
		row.append(button('Bind a secret', 'basic', async () => {
			const name = read();
			if (!name) return;
			const scope = await write('POST', '/secret-scopes',
				{repo_id: state.env.repo_id, secret_name: name, environment: state.env.name});
			if (!scope) return;
			await loadSecrets();
			render();
		}));
	}

	function drawDanger() {
		dangerForm.replaceChildren();
		if (!state.env.can_write) {
			dangerBox.classList.add('tw-hidden');
			return;
		}
		dangerBox.classList.remove('tw-hidden');
		const row = el('div', 'inline fields');
		dangerForm.append(row);
		const confirm = textField(row, `Type ${state.env.name} to confirm`, 'delivery-delete-confirm', 'text');
		const remove = button('Delete this environment', 'red', async () => {
			if (confirm.value !== state.env.name) return;
			if (await write('DELETE', envPath) === null) return;
			window.location.href = `${subURL}/delivery/environments`;
		});
		remove.disabled = true;
		confirm.addEventListener('input', () => {
			remove.disabled = confirm.value !== state.env.name;
		});
		row.append(remove);
	}

	function render() {
		drawIdentity();
		drawAddCheck();
		drawChecks();
		drawSecrets();
		drawDanger();
		detail.classList.remove('tw-hidden');
	}

	async function loadSiblings() {
		const params = new URLSearchParams({repo_id: String(state.env.repo_id), limit: '200', sort_by: 'sort_order'});
		state.siblings = await probe(`${base}/environments?${params}`) ?? [];
	}

	async function loadSecrets() {
		if (!state.repo) {
			state.secrets = null;
			return;
		}
		const path = environmentSecretsPath
			.replace('{owner}/{repo}', state.repo.full_name)
			.replace('{name}', encodeURIComponent(state.env.name));
		state.secrets = await probe(`${base}${path}?limit=200`);
	}

	async function load() {
		let payload;
		try {
			const resp = await fetch(`${base}${envPath}`, {headers: headers()});
			payload = await resp.json();
			if (!resp.ok) {
				if (resp.status === 401 || resp.status === 403) tokenBox.classList.remove('tw-hidden');
				fail(payload.message ?? `the API returned ${resp.status}`,
					payload.suggested_action ?? 'List /delivery/environments to see the environments you can read.');
				return;
			}
		} catch (err) {
			fail(String(err), `Check that you are signed in and that the delivery API is reachable at ${base}.`);
			return;
		}
		state.env = normalize(payload);
		if (state.env.repo_id) state.repo = await probe(`${gitea}/repositories/${state.env.repo_id}`);
		await Promise.all([loadSiblings(), loadSecrets()]);
		if (state.repo) {
			state.available = await probe(`${gitea}/repos/${state.repo.full_name}/actions/secrets?limit=100`);
			state.teams = await probe(`${gitea}/orgs/${state.repo.owner.login}/teams?limit=100`) ?? [];
		}
		for (const id of state.env.bypass_allowlist_user_ids) {
			const found = await probe(`${gitea}/users/search?uid=${id}`);
			if (found?.data?.length) state.userNames.set(id, found.data[0].login);
		}
		clearError();
		render();
	}

	document.querySelector('#delivery-token-save').addEventListener('click', () => {
		try {
			window.sessionStorage.setItem(tokenKey, document.querySelector('#delivery-token').value.trim());
		} catch {
			fail('this browser refused to keep the token for this tab',
				'Allow site data for this origin, or use the gitea-delivery CLI instead.');
			return;
		}
		load();
	});

	await load();
} else {
	const body = document.querySelector('#delivery-environments-body');
	const newBox = document.querySelector('#delivery-new');
	const repoNames = new Map();

	function cell(row, text) {
		const td = document.createElement('td');
		if (text !== undefined) td.textContent = text;
		row.append(td);
		return td;
	}

	async function scopeOf(env) {
		if (!env.repo_id) return 'instance-wide';
		if (!repoNames.has(env.repo_id)) {
			const repo = await probe(`${gitea}/repositories/${env.repo_id}`);
			repoNames.set(env.repo_id, repo ? repo.full_name : `repository ${env.repo_id}`);
		}
		return repoNames.get(env.repo_id);
	}

	async function create() {
		const name = document.querySelector('#delivery-new-name').value.trim();
		if (!name) {
			fail('an environment needs a name', 'Type a name, then press New environment.');
			return;
		}
		const full = document.querySelector('#delivery-new-repo').value.trim();
		let repoID = 0;
		if (full) {
			const repo = await probe(`${gitea}/repos/${full}`);
			if (!repo) {
				fail(`no repository ${full} is visible to you`, 'Check the owner and repository name, or leave it blank for an instance-wide environment.');
				return;
			}
			repoID = repo.id;
		}
		const created = await write('POST', '/environments',
			{repo_id: repoID, name, sort_order: 10, approval_policy: 'none', required_approvals: 1});
		if (!created) return;
		window.location.href = `${subURL}/delivery/environments/${created.id}/edit`;
	}

	async function load() {
		const params = new URLSearchParams({sort_by: 'sort_order', order: 'asc', limit: '200'});
		if (wanted) params.set('name', wanted);

		let payload;
		try {
			const resp = await fetch(`${base}/environments?${params}`, {headers: headers()});
			payload = await resp.json();
			if (!resp.ok) {
				if (resp.status === 401 || resp.status === 403) tokenBox.classList.remove('tw-hidden');
				fail(payload.message ?? `the API returned ${resp.status}`,
					payload.suggested_action ?? 'Retry, and check the server log if it keeps failing.');
				body.replaceChildren();
				return;
			}
		} catch (err) {
			fail(String(err), `Check that you are signed in and that the delivery API is reachable at ${base}.`);
			return;
		}

		newBox.classList.remove('tw-hidden'); // the endpoint refuses a scope the caller cannot write

		if (!payload.length) {
			body.replaceChildren();
			const row = document.createElement('tr');
			cell(row, wanted ? `No environment named "${wanted}" is visible to you.` : 'No environment is configured yet.')
				.colSpan = 5;
			body.append(row);
			clearError();
			return;
		}

		const rows = [];
		for (const env of payload) {
			const row = document.createElement('tr');
			cell(row).append(link(env.name, `${subURL}/delivery/environments/${env.id}/edit`));
			cell(row, await scopeOf(env));
			cell(row, env.sort_order);
			const chips = cell(row);
			for (const check of checks) {
				if (check.present(normalize(env))) chips.append(el('span', 'ui label', check.label), document.createTextNode(' '));
			}
			const links = cell(row);
			links.append(link('grid', `${subURL}/delivery/grid`), document.createTextNode(' · '),
				link('settings', `${subURL}/delivery/environments/${env.id}/edit`));
			rows.push(row);
		}
		body.replaceChildren(...rows);
		clearError();
	}

	document.querySelector('#delivery-create').addEventListener('click', create);
	document.querySelector('#delivery-token-save').addEventListener('click', () => {
		try {
			window.sessionStorage.setItem(tokenKey, document.querySelector('#delivery-token').value.trim());
		} catch {
			fail('this browser refused to keep the token for this tab',
				'Allow site data for this origin, or use the gitea-delivery CLI instead.');
			return;
		}
		load();
	});

	await load();
}
</script>
{{template "base/footer" .}}
