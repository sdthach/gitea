{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard delivery">
	<div class="ui container">
		<h2 class="ui header">{{.Title}}</h2>
		<p class="tw-text-14">
			Every deploy the review gate is holding, with who asked for it, the release, how long it
			has waited and a link to the run. Every figure is fetched from
			<code>{{.DeliveryAPIBase}}/reviews</code>; this page is a client of that endpoint and
			reads nothing the API does not serve. Approving or rejecting calls that same endpoint, so
			a user the forge does not permit to approve is refused by the server, not merely offered
			no button.
		</p>

		<div id="delivery-error" class="ui negative message tw-hidden">
			<div class="header">Could not load pending reviews</div>
			<p id="delivery-error-message"></p>
			<p><strong>Suggested action:</strong> <span id="delivery-error-action"></span></p>
		</div>

		<div id="delivery-token-box" class="ui warning message tw-hidden">
			<div class="header">This page needs an API token</div>
			<p>
				The delivery API authenticates with a token, not with your browser session, so that no
				review can be triggered by another site holding your cookie. Create one under
				Settings &gt; Applications and paste it here; it is kept in this tab only.
			</p>
			<div class="ui action input">
				<input id="delivery-token" type="password" autocomplete="off" placeholder="API token">
				<button id="delivery-token-save" class="ui primary button" type="button">Use token</button>
			</div>
		</div>

		<table class="ui table" id="delivery-approvals">
			<thead>
				<tr>
					<th>Repository</th>
					<th>Environment</th>
					<th>Release</th>
					<th>Requested by</th>
					<th>Age</th>
					<th>State</th>
					<th>Reviews</th>
					<th>Run</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody id="delivery-approvals-body">
				<tr><td colspan="9">Loading…</td></tr>
			</tbody>
		</table>

		<p class="tw-text-12">
			A rejection ends the deploy: the run does not proceed later. Both decisions are written to
			the append-only audit log naming the reviewer and the time.
		</p>
	</div>
</div>
<script type="module" nonce="{{ctx.CspScriptNonce}}">
const base = {{.DeliveryAPIBase}};
const subURL = {{.AppSubURL}};
const pageToken = {{.DeliveryPageToken}};
const wanted = {{.EnvironmentName}};
const body = document.querySelector('#delivery-approvals-body');
const tokenBox = document.querySelector('#delivery-token-box');
const tokenInput = document.querySelector('#delivery-token');

const tokenKey = 'delivery-api-token';
function storedToken() {
	try {
		return window.sessionStorage.getItem(tokenKey) ?? pageToken ?? '';
	} catch {
		return pageToken ?? '';
	}
}

function headers() {
	const out = {accept: 'application/json'};
	const token = storedToken();
	if (token) out.authorization = `token ${token}`;
	return out;
}

function fail(message, action) {
	document.querySelector('#delivery-error-message').textContent = message;
	document.querySelector('#delivery-error-action').textContent = action;
	document.querySelector('#delivery-error').classList.remove('tw-hidden');
}

function clearError() {
	document.querySelector('#delivery-error').classList.add('tw-hidden');
}

function cell(row, text) {
	const td = document.createElement('td');
	td.textContent = text;
	row.append(td);
	return td;
}

function age(seconds) {
	if (seconds < 60) return `${seconds}s`;
	if (seconds < 3600) return `${Math.floor(seconds / 60)}m`;
	if (seconds < 86400) return `${Math.floor(seconds / 3600)}h`;
	return `${Math.floor(seconds / 86400)}d`;
}

// decide posts one review or rejection. The endpoint is the ONLY thing that releases a
// held job, so a refusal here is the real answer and is shown with the action it suggests.
async function decide(review, verb) {
	clearError();
	const resp = await fetch(`${base}/reviews/${review.id}/${verb}`, {method: 'POST', headers: headers()});
	const payload = await resp.json().catch(() => ({}));
	if (!resp.ok) {
		if (resp.status === 401 || resp.status === 403) tokenBox.classList.remove('tw-hidden');
		fail(payload.message ?? `the API returned ${resp.status}`,
			payload.suggested_action ?? 'Retry, and check the server log if it keeps failing.');
		return;
	}
	await load();
}

async function load() {
	const params = new URLSearchParams({sort_by: 'created_unix', order: 'desc', limit: '200'});
	if (wanted) params.set('environment', wanted);

	let payload;
	try {
		const resp = await fetch(`${base}/reviews?${params}`, {headers: headers()});
		payload = await resp.json();
		if (!resp.ok) {
			if (resp.status === 401 || resp.status === 403) tokenBox.classList.remove('tw-hidden');
			fail(payload.message ?? `the API returned ${resp.status}`,
				payload.suggested_action ?? 'Retry, and check the server log if it keeps failing.');
			body.replaceChildren();
			return;
		}
	} catch (err) {
		fail(String(err), `Check that you are signed in and that the delivery API is reachable at ${base}.`);
		return;
	}

	clearError();
	tokenBox.classList.add('tw-hidden');
	if (!payload.length) {
		body.replaceChildren(Object.assign(document.createElement('tr'), {innerHTML: ''}));
		const tr = document.createElement('tr');
		cell(tr, wanted ? `nothing is awaiting review in "${wanted}"` : 'nothing is awaiting review').colSpan = 9;
		body.replaceChildren(tr);
		return;
	}

	body.replaceChildren(...payload.map((review) => {
		const tr = document.createElement('tr');
		cell(tr, `#${review.repo_id}`);
		cell(tr, review.environment);
		cell(tr, review.release_tag || '—');
		cell(tr, review.requester_login || `#${review.requester_id}`);
		cell(tr, age(review.age_seconds));
		cell(tr, review.state);
		cell(tr, `${review.reviews_count}/${review.required_reviewers}`);

		const run = document.createElement('td');
		if (review.run_url) {
			const a = document.createElement('a');
			a.href = review.run_url.startsWith('http') ? review.run_url : `${subURL}${review.run_url}`;
			a.textContent = `run ${review.run_id}`;
			run.append(a);
		} else {
			run.textContent = `run ${review.run_id}`;
		}
		tr.append(run);

		const actions = document.createElement('td');
		// A user without review rights is offered no action; can_approve is the server's
		// own answer, resolved by the same check the endpoint enforces.
		if (review.can_approve) {
			for (const [verb, label, cls] of [['approve', 'approve', 'ui mini primary button'], ['reject', 'reject', 'ui mini negative button']]) {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = cls;
				button.textContent = label;
				button.addEventListener('click', () => decide(review, verb));
				actions.append(button);
				actions.append(' ');
			}
		} else {
			actions.textContent = review.state === 'pending' ? 'not yours to review' : '—';
		}
		tr.append(actions);
		return tr;
	}));
}

document.querySelector('#delivery-token-save').addEventListener('click', () => {
	try {
		window.sessionStorage.setItem(tokenKey, tokenInput.value.trim());
	} catch {
		fail('this browser refused to keep the token for this tab',
			'Allow site data for this origin, or use the gitea-delivery CLI instead.');
		return;
	}
	load();
});

await load();
</script>
{{template "base/footer" .}}
