#
# The delivery fork's own make targets. The upstream Makefile carries one line including
# this file, so the fork adds no target to it (F2).
# See planning/slices/03-environments.md.

DELIVERY_TEST_PACKAGES := gitea.dev/models/delivery/... gitea.dev/services/delivery/... gitea.dev/routers/api/delivery/... gitea.dev/routers/web/delivery/... gitea.dev/cmd/gitea-delivery/...

.PHONY: delivery-generate
delivery-generate: ## regenerate the delivery OpenAPI document, CLI request layer and command reference
	$(GO) run ./tools/delivery-generate.go

.PHONY: delivery-generate-check
delivery-generate-check: ## fail when a generated delivery artifact differs from its source
	$(GO) run ./tools/delivery-generate.go -check

.PHONY: delivery-parity
delivery-parity: ## fail when a published delivery endpoint has no CLI command
	$(GO) run ./tools/delivery-parity.go

.PHONY: delivery-spoke-check
delivery-spoke-check: ## fail when the fork edits an upstream file outside the declared spoke set
	$(GO) run ./tools/delivery-spoke-check.go

.PHONY: delivery-test
delivery-test: ## run the delivery fork's Go unit tests
	@echo "Running delivery unit tests $(GOTEST_FLAGS) -tags '$(TAGS)'..."
	@$(GO) test $(GOTEST_FLAGS) -tags='$(TAGS)' $(DELIVERY_TEST_PACKAGES)

.PHONY: delivery-check
delivery-check: delivery-test delivery-generate-check delivery-parity delivery-spoke-check ## every delivery gate

.PHONY: delivery-integration
# One unanchored pattern, not a list of prefixes: enumerating them silently dropped
# TestDeliverySecretNarrowingEndToEnd and TestDeliveryJobEnvironmentReadsTheWorkflowFile,
# which matched neither. Every delivery test carries "Delivery" in its name.
delivery-integration: ## run the delivery fork's integration tests under Gitea's own harness (J8)
	@$(MAKE) --no-print-directory "test-integration#Delivery"
